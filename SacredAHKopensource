                    end
                end)
            end
        end

        -- 3. NPC ESP (ONLY ACTIVE FOR NPC ESP)
        if FeatureStates["NpcEsp"] and doTextUpdate then
            for npc, data in pairs(npcESPStore) do
                pcall(function()
                    if npc.Parent and data.char and data.char.Parent and data.lbl and data.bb and data.bb.Parent then
