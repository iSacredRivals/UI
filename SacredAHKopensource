        for part, saved in pairs(data.parts or {}) do
            pcall(function()
                if part and part.Parent then
                    part.Size = saved.Size
                    part.Color = saved.Color
                    part.Material = saved.Material
                    part.CanCollide = (saved.CanCollide ~= nil) and saved.CanCollide or true
                    if saved.Mesh and saved.Mesh.Parent ~= part then
                        saved.Mesh.Parent = part
                    end
                end
            end)
        end

        for joint, saved in pairs(data.joints or {}) do
            pcall(function()
                if joint and joint.Parent then
                    joint.C0 = saved.C0
                    joint.C1 = saved.C1
                end
            end)
        end

        bigSkinBugOriginal[char] = nil
