local function makeCard(parent, titleEN, titleES, h, y)
    local card = Instance.new("Frame")
    card.Size = UDim2.new(1, -10, 0, h)
    card.Position = UDim2.new(0, 5, 0, y)
    card.BackgroundColor3 = isGlassModeActive and Color3.fromRGB(14, 14, 20) or Color3.fromRGB(12, 12, 12)
    card.BackgroundTransparency = isGlassModeActive and 0.40 or 0
    card.BorderSizePixel = 0
    card.Parent = parent
    Instance.new("UICorner", card).CornerRadius = UDim.new(0, 8)
    local cStroke = Instance.new("UIStroke", card)
    cStroke.Color = Color3.fromRGB(48, 48, 55)
    cStroke.Thickness = 1
    cStroke.Transparency = isGlassModeActive and 0.35 or 0

    table.insert(AllCardFrames, card)
    if isSacredTransparentActive then
        card.BackgroundColor3 = Color3.fromRGB(5, 5, 10)
        card.BackgroundTransparency = currentGlassAlpha
        if cStroke then cStroke.Transparency = 0.40 end
    end

    local hdr = Instance.new("TextLabel", card)
    hdr.Size = UDim2.new(1, -14, 0, 24)
    hdr.Position = UDim2.new(0, 10, 0, 2)
    hdr.BackgroundTransparency = 1
    hdr.Font = Enum.Font.GothamBold
    hdr.Text = (CurrentLang == "EN") and titleEN or titleES
    hdr.TextSize = 13.5
    hdr.TextColor3 = Color3.fromRGB(230, 230, 235)
    hdr.TextXAlignment = Enum.TextXAlignment.Left

    table.insert(TranslatableUI, {
        label = hdr,
        en = titleEN,
        es = titleES,
        isHeader = true
    })
    return card
end

