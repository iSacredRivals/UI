    if input.UserInputType == Enum.UserInputType.Keyboard then
        for _, entry in ipairs(PCKeybinds) do
            if entry.key and input.KeyCode == entry.key then
                if entry.mode == "Toggle" then
                    toggleFeature(entry.id)
                else
                    if entry.id == "MacroCombo" then
                        if executeMacroCombo then executeMacroCombo() end
                    elseif entry.id == "SwitchCamLock" then
                        if FeatureCallbacks["SwitchCamLock"] then
                            pcall(FeatureCallbacks["SwitchCamLock"], true)
                        end
                    elseif FeatureCallbacks[entry.id] then
                        pcall(FeatureCallbacks[entry.id], true)
                    end
                    notifyToggle("Triggered: " .. entry.name, true)
                end
            end
        end
    end
end))

return ScreenGui
