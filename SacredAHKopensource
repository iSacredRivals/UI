    end

    local function getCategoryForSlot(rawSlot)
        if type(rawSlot) == "string" then
            if rawSlot == "Melee" or rawSlot == "Sword" or rawSlot == "Gun" or rawSlot == "Fruit" then
                return rawSlot
            end
        end
        local num = tonumber(rawSlot)
        if num == 1 then return "Melee"
        elseif num == 2 then return "Fruit"
        elseif num == 3 then return "Sword"
        elseif num == 4 then return "Gun" end
        return nil
    end

    local function safeEquipCategory(targetCat)
        if not targetCat or targetCat == "None" then return end
        local char = LocalPlayer.Character
        if not char then return end
        local currentTool = char:FindFirstChildOfClass("Tool")
        if currentTool and getToolCategory(currentTool) == targetCat then
            return currentTool
        end

        local bp = LocalPlayer:FindFirstChildOfClass("Backpack") or LocalPlayer:FindFirstChild("Backpack")
        local toolToEquip = nil
        if bp then
            for _, t in ipairs(bp:GetChildren()) do
                if t:IsA("Tool") and getToolCategory(t) == targetCat then
                    toolToEquip = t
                    break
                end
            end
        end

        local hum = char:FindFirstChildOfClass("Humanoid")
        if toolToEquip and hum then
            hum:EquipTool(toolToEquip)
            local t0 = tick()
            while tick() - t0 < 0.25 do
                if char:FindFirstChild(toolToEquip.Name) then break end
                task.wait(0.03)
            end
            return toolToEquip
        end

        local slotNum = toolToSlotNum[targetCat] or 1
        local kc = SLOT_KEYS[slotNum]
        if kc then
            pressKey(kc, 0.05)
            task.wait(0.12)
        end
        return char:FindFirstChildOfClass("Tool")
    end

    local function clickMacroMouse(waitDuration)
        pcall(function()
            local vu = game:GetService("VirtualUser")
            vu:CaptureController()
            vu:Button1Down(Vector2.zero)
            task.wait(waitDuration or 0.08)
            vu:Button1Up(Vector2.zero)
        end)
    end

    local function executeMacroCombo()
        if isMacroExecuting then
            isMacroExecuting = false
            notifyToggle("Macro Stopped", false)
            return
        end
        isMacroExecuting = true
        notifyToggle("Macro Started", true)
        task.spawn(function()
            local prevCategory = nil
            local function runOnce()
                for slotIdx = 1, 14 do
                    if not isMacroExecuting then break end
                    local item = Settings.macroSteps and Settings.macroSteps[slotIdx]
                    if item and item.enabled and item.key and item.key ~= "None" and item.key ~= "OFF" then
                        local rawSlot = item.tool or item.slot or 1
                        local targetCat = getCategoryForSlot(rawSlot)

                        if targetCat and targetCat ~= prevCategory and targetCat ~= "None" then
                            safeEquipCategory(targetCat)
                            prevCategory = targetCat
                            task.wait(0.12)
                        end

                        local char = LocalPlayer.Character
                        if char then
                            local t0 = tick()
                            while tick() - t0 < 0.40 do
                                local isBusy = char:GetAttribute("Busy") == true
                                local stunVal = char:GetAttribute("Stun")
                                local isStunned = (type(stunVal) == "number" and stunVal > 0)
                                if isBusy or isStunned then
                                    task.wait(0.03)
                                else
                                    break
                                end
                            end
                        end

                        local holdTime = math.max(item.hold or 0.10, 0.08)

                        if item.key == "M1" or item.key == "TAP" then
                            clickMacroMouse(holdTime)
                        else
                            local kc = Enum.KeyCode[item.key]
                            if kc then
                                pressKey(kc, holdTime)
                            end
                        end

                        if item.jumpsAfter and item.jumpsAfter > 0 then
                            for j = 1, item.jumpsAfter do
                                local c = LocalPlayer.Character
                                local h = c and c:FindFirstChildOfClass("Humanoid")
                                if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end
                                task.wait(0.08)
                            end
                        end

                        task.wait(math.max(item.delay or 0.30, 0.15))
                    end
                end
            end

            if macroLoopMode == "Loop" then
                while isMacroExecuting do
                    runOnce()
                    task.wait(0.10)
                end
            else
                runOnce()
                isMacroExecuting = false
            end
        end)
    end
    _G.ExecuteMacroCombo = executeMacroCombo

