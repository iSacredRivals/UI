    local function getBloxFruitsControlButtons()
        local btns = {}
        local pGui = LocalPlayer:FindFirstChild("PlayerGui")
        if not pGui then return btns end

        -- MobileContextButtons (Dash, Buso, Ken, Soru, Run, RaceAbility)
        local mcb = pGui:FindFirstChild("MobileContextButtons")
        if mcb and mcb:FindFirstChild("ContextButtonFrame") then
            for _, child in ipairs(mcb.ContextButtonFrame:GetChildren()) do
                if child:IsA("GuiObject") then
                    table.insert(btns, child)
                end
            end
        end

        -- Skills in Main
        local main = pGui:FindFirstChild("Main")
        if main then
            local skills = main:FindFirstChild("Skills")
            if skills then
                for _, child in ipairs(skills:GetChildren()) do
                    if child:IsA("GuiObject") then
                        table.insert(btns, child)
                    end
                end
            end
            local bHud = main:FindFirstChild("BottomHUDList")
            if bHud and bHud:FindFirstChild("UniversalContextButtons") then
                for _, child in ipairs(bHud.UniversalContextButtons:GetChildren()) do
                    if child:IsA("GuiObject") then
                        table.insert(btns, child)
                    end
                end
            end
        end

        -- Jump Button in TouchGui
        local touchGui = pGui:FindFirstChild("TouchGui")
        if touchGui and touchGui:FindFirstChild("TouchControlFrame") then
            local jb = touchGui.TouchControlFrame:FindFirstChild("JumpButton")
            if jb and jb:IsA("GuiObject") then
                table.insert(btns, jb)
            end
        end

        return btns
    end

    local function saveControlsLayoutToFile()
        pcall(function()
            if writefile then
                local json = HttpService:JSONEncode(_G.DarlingAHK_ControlsLayout)
                writefile("DarlingAHK_ControlsLayout.json", json)
            end
        end)
    end

    local function loadControlsLayoutFromFile()
        pcall(function()
            local json = nil
            if isfile and isfile("DarlingAHK_ControlsLayout.json") and readfile then
                json = readfile("DarlingAHK_ControlsLayout.json")
            end
            if json and json ~= "" then
                local ok, data = pcall(function() return HttpService:JSONDecode(json) end)
                if ok and data and type(data) == "table" then
                    _G.DarlingAHK_ControlsLayout = data
                    for _, btn in ipairs(getBloxFruitsControlButtons()) do
                        local saved = _G.DarlingAHK_ControlsLayout[btn.Name]
                        if saved then
                            if saved.X and saved.Y then
                                btn.Position = UDim2.new(0, saved.X, 0, saved.Y)
                            elseif saved.scaleX and saved.offsetX then
                                btn.Position = UDim2.new(saved.scaleX, saved.offsetX, saved.scaleY, saved.offsetY)
                            end
                            if saved.scale then
                                local uiScale = btn:FindFirstChildOfClass("UIScale")
                                if not uiScale then uiScale = Instance.new("UIScale", btn) end
                                uiScale.Scale = saved.scale
                            end
                        end
                    end
                end
            end
        end)
    end

