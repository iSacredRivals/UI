        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then return nil end
        local closestSeat, minDist = nil, math.huge
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("VehicleSeat") or obj:IsA("Seat") then
                local dist = (obj.Position - root.Position).Magnitude
                if dist < minDist and dist <= 120 then
                    minDist = dist
                    closestSeat = obj
                end
            end
        end
        if closestSeat then
            local model = closestSeat:FindFirstAncestorOfClass("Model")
            if model and model ~= char and model.Parent ~= workspace:FindFirstChild("Characters") then
                currentShipFound = model
                return model
            end
        end
        return nil
    end

