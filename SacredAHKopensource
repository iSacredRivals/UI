    local function GetToolByType(toolType)
        local char = LocalPlayer.Character
        local pack = LocalPlayer:FindFirstChildOfClass("Backpack")
        local sources = {}
        if char then table.insert(sources, char) end
        if pack then table.insert(sources, pack) end

        for _, src in ipairs(sources) do
            for _, t in ipairs(src:GetChildren()) do
                if t:IsA("Tool") then
                    if t.ToolTip == toolType or getToolCategory(t) == toolType then
                        return t
                    end
                end
            end
        end
        return nil
    end

