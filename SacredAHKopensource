    local function formatCommas(n)
        local s = tostring(math.floor(n or 0))
        local k
        while true do
            s, k = string.gsub(s, "^(-?%d+)(%d%d%d)", "%1,%2")
            if k == 0 then break end
        end
        return s
    end

