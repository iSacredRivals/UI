    local function drawBone(line, partA, partB, cam, col)
        if not line then return end
        if not partA or not partB or not partA.Parent or not partB.Parent then
            line.Visible = false
            return
        end
        local pA, onA = cam:WorldToViewportPoint(partA.Position)
        local pB, onB = cam:WorldToViewportPoint(partB.Position)
        if (onA or onB) and pA.Z > 0 and pB.Z > 0 then
            line.From = Vector2.new(pA.X, pA.Y)
            line.To = Vector2.new(pB.X, pB.Y)
            line.Color = col
            line.Thickness = 3.5
            line.Visible = true
        else
            line.Visible = false
        end
    end

    local function drawBox(square, char, cam, col)
        if not square or not char or not char.Parent then
            if square then square.Visible = false end
            return
        end
        local hrp = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head") or char.PrimaryPart
        if not hrp then
            square.Visible = false
            return
        end
        local cf = hrp.CFrame
        local sz = Vector3.new(4, 5.5, 2.5)
        local camPos = cam.CFrame.Position
        local dir = (cf.Position - camPos)
        if cam.CFrame.LookVector:Dot(dir) <= 0 then
            square.Visible = false
            return
        end
        local topWorld = cf.Position + Vector3.new(0, sz.Y * 0.58, 0)
        local btmWorld = cf.Position - Vector3.new(0, sz.Y * 0.58, 0)
        local pTop, onTop = cam:WorldToViewportPoint(topWorld)
        local pBtm, onBtm = cam:WorldToViewportPoint(btmWorld)
        if (onTop or onBtm) and pTop.Z > 0 and pBtm.Z > 0 then
            local boxH = math.abs(pBtm.Y - pTop.Y)
            local boxW = boxH * 0.68
            if boxH > 4 and boxW > 3 then
                local midX = (pTop.X + pBtm.X) * 0.5
                local minY = math.min(pTop.Y, pBtm.Y)
                square.Size = Vector2.new(boxW, boxH)
                square.Position = Vector2.new(midX - boxW * 0.5, minY)
                square.Color = col
                square.Thickness = 2.8
                square.Visible = true
                return
            end
        end
        square.Visible = false
    end

    local function rebuildESPs()
        local isGen     = FeatureStates["GeneralEsp"]
        local isPlayer  = FeatureStates["PlayerEsp"]
        local isMatcha  = FeatureStates["EspMatcha"]
        local isNpc     = FeatureStates["NpcEsp"]
        local isFruit   = FeatureStates["FruitEsp"]
        local isRainbow = FeatureStates["RainbowEsp"]

        if isGen or isPlayer or isRainbow then
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character then
                    if isGen then
                        setupGeneralESP(p)
                    else
                        setupPlayerESP(p)
                    end
                end
            end
        else
            for p, _ in pairs(bespokeESPStore) do
                cleanPlayerBespokeESP(p)
            end
            bespokeESPStore = {}
        end

        if isMatcha then
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character then
                    setupMatchaESP(p)
                end
            end
        else
            for p, _ in pairs(matchaESPStore) do
                cleanMatchaESP(p)
            end
            matchaESPStore = {}
        end

        if isNpc then
            scanAndSetupAllNPCs()
        else
            for npc, _ in pairs(npcESPStore) do
                cleanNPCESP(npc)
            end
            npcESPStore = {}
        end

        if isFruit then
            updateFruitESP()
        else
            for fr, _ in pairs(fruitESPStore) do
                cleanFruitESP(fr)
            end
            fruitESPStore = {}
        end
    end

