local UIScale = Instance.new("UIScale", MAINUIframe)
local currentBaseScale = 0.75

local function updateMobileScaling()
    local camera = workspace.CurrentCamera
    if not camera then return end
    local viewport = camera.ViewportSize
    local scaleX = (viewport.X * 0.88) / 800
    local scaleY = (viewport.Y * 0.86) / 450
    local minScale = math.min(scaleX, scaleY, 1)
    currentBaseScale = math.clamp(minScale * 0.92, 0.30, 0.76)
    if MAINUIframe.Visible then
        UIScale.Scale = currentBaseScale
    end
end

updateMobileScaling()
if workspace.CurrentCamera then
    workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateMobileScaling)
end

local function makeDraggable(dragBar, mainFrame)
    local dragging, dragInput, dragStart, startPos = false, nil, nil, nil

    local function update(input)
        local delta = input.Position - dragStart
        local s = (UIScale and UIScale.Scale > 0.1) and UIScale.Scale or 1
        mainFrame.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + (delta.X / s),
            startPos.Y.Scale,
            startPos.Y.Offset + (delta.Y / s)
        )
    end

    dragBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = mainFrame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)

    dragBar.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then update(input) end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

