local function updateToggleVisual(name, active)
    local data = ToggleButtons[name]
    if data then
        TweenService:Create(data.btn, TweenInfo.new(0.15), {
            BackgroundColor3 = active and Color3.fromRGB(36, 36, 42) or Color3.fromRGB(18, 18, 22),
            TextColor3       = active and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(180, 180, 190)
        }):Play()
        TweenService:Create(data.dot, TweenInfo.new(0.15), {
            BackgroundColor3 = active and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(45, 45, 52)
        }):Play()
    end
end

local function setFeatureState(name, active, skipCallback)
    FeatureStates[name] = active
    updateToggleVisual(name, active)
    if not skipCallback and FeatureCallbacks[name] then
        task.spawn(function()
            pcall(FeatureCallbacks[name], active)
        end)
    end
end

local function notifyToggle(name, state)
    local status = state and (CurrentLang == "EN" and "ENABLED" or "ACTIVADO") or (CurrentLang == "EN" and "DISABLED" or "DESACTIVADO")
    print(string.format("[Darling AHK] %s: %s", name, status))
end

local function toggleFeature(name)
    local newState = not (FeatureStates[name] or false)
    setFeatureState(name, newState)
    local data = ToggleButtons[name]
    local labelText = data and data.text or name
    notifyToggle(labelText, newState)
    return newState
end
_G.toggleFeature = toggleFeature
_G.setFeatureState = setFeatureState

local function universalCopy(text)
    local copied = false
    pcall(function()
        if setclipboard then setclipboard(text); copied = true
        elseif toclipboard then toclipboard(text); copied = true
        elseif syn and syn.write_clipboard then syn.write_clipboard(text); copied = true
        elseif write_clipboard then write_clipboard(text); copied = true end
    end)
    return copied
end

local function universalPaste()
    local text = ""
    pcall(function()
        if getclipboard then text = getclipboard()
        elseif syn and syn.read_clipboard then text = syn.read_clipboard() end
    end)
    return text
end

