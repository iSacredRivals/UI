    local function startFlyEngine()
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum then return end
        if flyBV then flyBV:Destroy(); flyBV = nil end
        if flyBG then flyBG:Destroy(); flyBG = nil end

        -- CRITICAL: Never force Enum.HumanoidStateType.Physics or PlatformStand = true!
        -- Setting Physics or PlatformStand causes Blox Fruits to detect ragdoll/stun,
        -- which immediately strips Buso Haki (Aura), Ken Haki, cancels Q Dash, and blocks skills.
        hum.PlatformStand = false

        flyBV = Instance.new("BodyVelocity")
        flyBV.Name = "Darling_FlyVelocity"
        flyBV.MaxForce = Vector3.new(1e9, 1e9, 1e9)
        flyBV.Velocity = Vector3.new(0, 0, 0)
        flyBV.Parent = hrp

        flyBG = Instance.new("BodyGyro")
        flyBG.Name = "Darling_FlyGyro"
        flyBG.MaxTorque = Vector3.new(9e4, 9e4, 9e4)
        flyBG.P = 9e4
        -- Keep upright yaw orientation so the character never flips or tilts face-down
        local cam = workspace.CurrentCamera
        local camCF = cam and cam.CFrame or hrp.CFrame
        local flatLook = Vector3.new(camCF.LookVector.X, 0, camCF.LookVector.Z)
        if flatLook.Magnitude > 0.001 then
            flyBG.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + flatLook.Unit)
        else
            flyBG.CFrame = hrp.CFrame
        end
        flyBG.Parent = hrp

        -- Listen for Dash (Q key) so air dash works explosively during flight
        if flyInputConn then flyInputConn:Disconnect() end
        flyInputConn = UserInputService.InputBegan:Connect(function(input, gpe)
            if gpe or not flyOn then return end
            if input.KeyCode == Enum.KeyCode.Q and not UserInputService:GetFocusedTextBox() then
                local c = LocalPlayer.Character
                local cm = workspace.CurrentCamera
                if c and cm then
                    local h = c:FindFirstChild("HumanoidRootPart")
                    local hm = c:FindFirstChildOfClass("Humanoid")
                    if h and hm then
                        local cCF = cm.CFrame
                        local fwd = cCF.LookVector
                        local rgt = cCF.RightVector
                        local dir = Vector3.new(0, 0, 0)
                        if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir = dir + fwd end
                        if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir = dir - fwd end
                        if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir = dir + rgt end
                        if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir = dir - rgt end
                        if hm.MoveDirection.Magnitude > 0.05 then
                            local md = hm.MoveDirection
                            local fltL = Vector3.new(fwd.X, 0, fwd.Z).Unit
                            local fltR = Vector3.new(rgt.X, 0, rgt.Z).Unit
                            dir = (fwd * md:Dot(fltL) + rgt * md:Dot(fltR))
                        end
                        if dir.Magnitude < 0.05 then
                            dir = fwd
                        end
                        flyDashDir = dir.Unit
                        isFlyDashing = true
                        flyDashEndTime = tick() + 0.3
                    end
                end
            end
        end)

        if flyNoclipConn then flyNoclipConn:Disconnect() end
        flyNoclipConn = RunService.Stepped:Connect(function()
            if not flyOn then return end
            local c = LocalPlayer.Character
            if not c then return end
            -- Only make main torso non-colliding during active flight to glide through obstacles
            -- without ruining ground checks or limb physics
            for _, part in pairs(c:GetChildren()) do
                if part:IsA("BasePart") and (part.Name == "Torso" or part.Name == "UpperTorso" or part.Name == "LowerTorso" or part.Name == "Head") then
                    part.CanCollide = false
                end
            end
        end)

        if flyLoopConn then flyLoopConn:Disconnect() end
        flyLoopConn = RunService.RenderStepped:Connect(function()
            if not flyOn then destroyFlyEngine(); return end
            local c = LocalPlayer.Character
            local h = c and c:FindFirstChild("HumanoidRootPart")
            local hm = c and c:FindFirstChildOfClass("Humanoid")
            local cam = workspace.CurrentCamera
            if not h or not hm or not cam then return end
            if not flyBV or not flyBV.Parent or flyBV.Parent ~= h then startFlyEngine(); return end

            -- Keep character standing upright, oriented towards camera horizontal direction
            local camCF = cam.CFrame
            local forward = camCF.LookVector
            local right = camCF.RightVector
            local flatLook = Vector3.new(forward.X, 0, forward.Z)
            if flatLook.Magnitude > 0.001 and flyBG then
                flyBG.CFrame = CFrame.lookAt(h.Position, h.Position + flatLook.Unit)
            end

            local currentFlySpeed = Settings.flySpeed or 350

            -- Check active Dash boost
            if isFlyDashing and tick() < flyDashEndTime then
                local dashSpd = math.max(currentFlySpeed * 1.8, (Settings.dashDist or 500) * 1.5)
                flyBV.Velocity = flyDashDir * dashSpd
                return
            else
                isFlyDashing = false
            end

            -- Direction calculation (WASD + Space / Shift)
            local moveDir = Vector3.new(0, 0, 0)
            pcall(function()
                if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + forward end
                if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - forward end
                if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + right end
                if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - right end
            end)
            pcall(function()
                if hm.MoveDirection.Magnitude > 0.05 then
                    local md = hm.MoveDirection
                    local flatLookUnit = Vector3.new(forward.X, 0, forward.Z).Unit
                    local flatRightUnit = Vector3.new(right.X, 0, right.Z).Unit
                    moveDir = (forward * md:Dot(flatLookUnit) + right * md:Dot(flatRightUnit))
                end
            end)
            local upDir = Vector3.new(0, 0, 0)
            pcall(function()
                if UserInputService:IsKeyDown(Enum.KeyCode.Space) then upDir = upDir + Vector3.new(0, 1, 0) end
                if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
                    upDir = upDir - Vector3.new(0, 1, 0)
                end
            end)

            local finalDir = Vector3.new(0, 0, 0)
            if moveDir.Magnitude > 0.05 then finalDir = finalDir + moveDir.Unit end
            if upDir.Magnitude > 0.05 then finalDir = finalDir + upDir.Unit end

            if finalDir.Magnitude > 0.05 then
                flyBV.Velocity = finalDir.Unit * currentFlySpeed
            else
                flyBV.Velocity = Vector3.new(0, 0, 0)
            end
        end)
    end

