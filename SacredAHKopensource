        local chosenFont = FONT_ENUMS[Settings.fontIdx] or Enum.Font.GothamBold
        if v then
            for _, obj in ipairs(PlayerGui:GetDescendants()) do
                if (obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox")) and not obj:IsDescendantOf(ScreenGui) then
                    if not originalFonts[obj] then originalFonts[obj] = obj.Font end
                    pcall(function() obj.Font = chosenFont end)
                end
            end
        else
            for obj, origFont in pairs(originalFonts) do
                pcall(function() obj.Font = origFont end)
            end
            originalFonts = {}
        end
    end

