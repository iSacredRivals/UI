            return nil, "NOT_EQUIPPED"
        end
        local gui = LocalPlayer:FindFirstChild("PlayerGui")
        local main = gui and gui:FindFirstChild("Main")
        local skills = main and main:FindFirstChild("Skills")
        if not skills then return nil, "NO_SKILLS_GUI" end
        local ts = skills:FindFirstChild(tool.Name)
        if not ts then return nil, "NO_TOOL_SKILL_GUI" end
        local sf = ts:FindFirstChild(skill)
        if not sf then return nil, "NO_SKILL_GUI" end
        local cd = sf:FindFirstChild("Cooldown")
        if not cd or not cd:IsA("GuiObject") then return nil, "NO_COOLDOWN_GUI" end
        return cd.AbsoluteSize.X, "OK"
    end

    local function CanUseSkill(skill)
        if not ValidSkills[skill] or skill == "TAP" then return true end
        local tool = GetEquippedTool()
        if not tool then return false end
        local sizeX, status = GetSkillCooldown(skill, tool)
        if sizeX == nil then
            return true
        end
        return sizeX <= 0
    end

    local function UseKey(key, isHold)
        local skill = key.Name
        if not CanUseSkill(skill) then return end
        faceMacroTarget()
        SendKey(key, true)
        if not isHold then
            task.wait(0.06)
            SendKey(key, false)
        end
    end

    local function Unhold(key)
        if not LocalPlayer.Character then return end
        SendKey(key, false)
    end

    local function HoldTap()
        if TapHeld then return end
        TapHeld = true
        faceMacroTarget()
        local vim = game:GetService("VirtualInputManager")
        vim:SendMouseButtonEvent(0, 0, 0, true, game, 0)
    end

    local function UnholdTap()
        if not TapHeld then return end
        TapHeld = false
        local vim = game:GetService("VirtualInputManager")
        vim:SendMouseButtonEvent(0, 0, 0, false, game, 0)
    end

    local function Tap()
        faceMacroTarget()
        local vim = game:GetService("VirtualInputManager")
        vim:SendMouseButtonEvent(0, 0, 0, true, game, 0)
        task.wait(0.05)
        vim:SendMouseButtonEvent(0, 0, 0, false, game, 0)
    end

    local function EquipToolType(toolType)
        local char = LocalPlayer.Character
        if not char then return false end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum then return false end

        local tool = GetToolByType(toolType)
        if not tool then return false end

        if tool.Parent ~= char then
            hum:EquipTool(tool)
        end

        local pingSec = getClientPing() / 1000
        local maxWait = math.clamp(0.6 + (pingSec * 2), 0.7, 2.0)
        local t0 = os.clock()
        while (os.clock() - t0 < maxWait) and (tool.Parent ~= char) do
            task.wait(0.02)
        end

        local gui = LocalPlayer:FindFirstChild("PlayerGui")
        local skills = gui and gui:FindFirstChild("Main") and gui.Main:FindFirstChild("Skills")
        if skills then
            t0 = os.clock()
            while (os.clock() - t0 < 0.5) and not skills:FindFirstChild(tool.Name) do
                task.wait(0.02)
            end
        end
        return tool.Parent == char
    end

    local function ReleaseAll()
        for _, k in ipairs({ "Z", "X", "C", "V", "F" }) do
            pcall(Unhold, Enum.KeyCode[k])
        end
        pcall(UnholdTap)
    end

    local function StopSequence()
        MacroRunning = false
        ReleaseAll()
    end

    local function RunSequence(sequence)
        if MacroRunning then return end
        MacroRunning = true
        isSimulatingKeys = true

        task.spawn(function()
            pcall(function()
                for _, cmd in ipairs(string.split(sequence, "&")) do
                    if not MacroRunning then break end
                    cmd = cmd:match("^%s*(.-)%s*$")

                    local waitT = cmd:match("^wait%s*%(?([%d%.]+)%)?$")
                    if waitT then
                        local w = tonumber(waitT) or 0.3
                        local pingSec = getClientPing() / 1000
                        if pingSec > 0.1 then w = w + (pingSec * 0.15) end
                        task.wait(w)
                    elseif ValidWeapons[cmd] then
                        EquipToolType(ValidWeapons[cmd])
                    elseif cmd == "holdTAP" then
                        HoldTap()
                    elseif cmd == "unholdTAP" then
                        UnholdTap()
                    elseif cmd == "TAP" then
                        Tap()
                    elseif cmd:match("^hold(.+)$") then
                        local s = cmd:match("^hold(.+)$")
                        if ValidSkills[s] and s ~= "TAP" then
                            local kc = Enum.KeyCode[s]
                            if kc then UseKey(kc, true) end
                        end
                    elseif cmd:match("^unhold(.+)$") then
                        local s = cmd:match("^unhold(.+)$")
                        if ValidSkills[s] and s ~= "TAP" then
                            local kc = Enum.KeyCode[s]
                            if kc then Unhold(kc) end
                        end
                    elseif ValidSkills[cmd] and cmd ~= "TAP" then
                        local kc = Enum.KeyCode[cmd]
                        if kc then UseKey(kc, false) end
                    end
                end
            end)
            ReleaseAll()
            MacroRunning = false
            isSimulatingKeys = false
        end)
    end

