    -- 5. TRACKER (ORIGINAL STICK TO TARGET)
    local TrackerGui = nil
    local trackerStickEnabled = false
    local trackerLockedChar = nil

    local function createTrackerWidget()
        if TrackerGui and TrackerGui.Parent then TrackerGui:Destroy() end
        local gui = Instance.new("ScreenGui")
        gui.Name = "SacredTrackerWidget"
        gui.ResetOnSpawn = false
        safeParent(gui)
        TrackerGui = gui

        local floatBtn = Instance.new("TextButton", gui)
        floatBtn.Name = "TrackerToggle"
        floatBtn.Size = UDim2.new(0, 72, 0, 32)
        floatBtn.Position = UDim2.new(0, 20, 0.42, 0)
        floatBtn.BackgroundColor3 = Color3.fromRGB(15, 15, 18)
        floatBtn.BackgroundTransparency = 0.25
        floatBtn.Text = "TRACKER"
        floatBtn.TextSize = 11
        floatBtn.TextColor3 = Color3.fromRGB(180, 180, 180)
        floatBtn.Font = Enum.Font.GothamBold
        floatBtn.Active = true
        floatBtn.Draggable = true
        Instance.new("UICorner", floatBtn).CornerRadius = UDim.new(0, 8)
        local fStroke = Instance.new("UIStroke", floatBtn)
        fStroke.Color = Color3.fromRGB(48, 48, 55)
        fStroke.Thickness = 1.5

        local trackerConn = nil

        local function stopTracker()
            trackerStickEnabled = false
            trackerLockedChar = nil
            if trackerConn then
                trackerConn:Disconnect()
                trackerConn = nil
            end
            fStroke.Color = Color3.fromRGB(48, 48, 55)
            floatBtn.TextColor3 = Color3.fromRGB(180, 180, 180)
        end

        floatBtn.MouseButton1Click:Connect(function()
            trackerStickEnabled = not trackerStickEnabled
            fStroke.Color = trackerStickEnabled and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(48, 48, 55)
            floatBtn.TextColor3 = trackerStickEnabled and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(180, 180, 180)
            if not trackerStickEnabled then
                stopTracker()
                return
            end

            if trackerConn then trackerConn:Disconnect() end
            trackerConn = RunService.Stepped:Connect(function(step, dt)
                if not trackerStickEnabled then
                    stopTracker()
                    return
                end
                local char = LocalPlayer.Character
                local myHRP = char and char:FindFirstChild("HumanoidRootPart")
                if not myHRP then return end

                myHRP.CanCollide = false

                local targetChar = nil
                if trackerLockedChar and trackerLockedChar.Parent and trackerLockedChar:FindFirstChild("HumanoidRootPart") then
                    local hum = trackerLockedChar:FindFirstChildOfClass("Humanoid")
                    if hum and hum.Health > 0 then
                        targetChar = trackerLockedChar
                    end
                end

                if not targetChar then
                    local closest, closestDist = nil, 650
                    for _, p in ipairs(Players:GetPlayers()) do
                        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                            local hum = p.Character:FindFirstChildOfClass("Humanoid")
                            if hum and hum.Health > 0 then
                                local d = (p.Character.HumanoidRootPart.Position - myHRP.Position).Magnitude
                                if d < closestDist then
                                    closest = p.Character
                                    closestDist = d
                                end
                            end
                        end
                    end
                    if not closest then
                        for _, p in ipairs(Players:GetPlayers()) do
                            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                                local hum = p.Character:FindFirstChildOfClass("Humanoid")
                                if hum and hum.Health > 0 then
                                    local d = (p.Character.HumanoidRootPart.Position - myHRP.Position).Magnitude
                                    if d < closestDist then
                                        closest = p.Character
                                        closestDist = d
                                    end
                                end
                            end
                        end
                    end
                    trackerLockedChar = closest
                    targetChar = closest
                end

                if targetChar and targetChar:FindFirstChild("HumanoidRootPart") then
                    local tHrp = targetChar.HumanoidRootPart
                    local tHum = targetChar:FindFirstChildOfClass("Humanoid")
                    if tHum and tHum.Health > 0 and (myHRP.Position - tHrp.Position).Magnitude <= 700 then
                        local dist = Settings.trackerDist or 3.5
                        myHRP.CFrame = tHrp.CFrame * CFrame.new(0, 0, dist)
                        myHRP.AssemblyLinearVelocity = tHrp.AssemblyLinearVelocity
                    else
                        trackerLockedChar = nil
                    end
                end
            end)
            registerConnection(trackerConn)
        end)
    end

    FeatureCallbacks["Tracker"] = function(v)
        if v then createTrackerWidget()
        else
            trackerStickEnabled = false
            trackerLockedChar = nil
            if TrackerGui then TrackerGui:Destroy(); TrackerGui = nil end
        end
    end

    -- 6. CENTUDOX CAMLOCK ENGINE (ACCURATE PREDICTION & DRAGGABLE SCREEN WIDGET)
    local CamLockGui = nil
    local camLockConn = nil
    local camLockLocked = false
    local camLockTarget = nil

    local function findNearestCamLockEnemy()
        local dist = math.huge
        local screenCenter
        local ok, res = pcall(function() return GuiService:GetScreenResolution() end)
        if ok and res and res.X > 0 and res.Y > 0 then
            screenCenter = Vector2.new(res.X / 2, res.Y / 2)
        else
            local cam = workspace.CurrentCamera
            screenCenter = cam and Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2) or Vector2.new(640, 360)
        end

        local closestPart = nil
        local cam = workspace.CurrentCamera
        if not cam then return nil end

        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                local char = player.Character
                if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") then
                    if char.Humanoid.Health > 0 then
                        local partToLock = (Settings.camLockTargetPart == "Head" and char:FindFirstChild("Head")) or char.HumanoidRootPart
                        local pos, visible = cam:WorldToViewportPoint(partToLock.Position)
                        if visible then
                            local magnitude = (screenCenter - Vector2.new(pos.X, pos.Y)).Magnitude
                            if magnitude < dist then
                                closestPart = partToLock
                                dist = magnitude
                            end
                        end
                    end
                end
            end
        end
        return closestPart
    end

    local function stopCamLockTracking()
        if camLockConn then
            camLockConn:Disconnect()
            camLockConn = nil
        end
        camLockLocked = false
        camLockTarget = nil
        if CamLockGui and CamLockGui.Parent then
            local btn = CamLockGui:FindFirstChild("CamLockButton", true)
            if btn then
                btn.Text = "CamLock: OFF"
                btn.TextColor3 = Color3.fromRGB(180, 180, 180)
                local stroke = btn:FindFirstChildOfClass("UIStroke")
                if stroke then stroke.Color = Color3.fromRGB(48, 48, 55) end
            end
        end
    end

    local function startCamLockTracking()
        camLockTarget = findNearestCamLockEnemy()
        if not camLockTarget then
            stopCamLockTracking()
            notifyToggle("No visible enemy in view", false)
            return
        end

        camLockLocked = true
        if CamLockGui and CamLockGui.Parent then
            local btn = CamLockGui:FindFirstChild("CamLockButton", true)
            if btn then
                local tName = camLockTarget.Parent and camLockTarget.Parent.Name or "ON"
                if #tName > 10 then tName = string.sub(tName, 1, 9) .. ".." end
                btn.Text = "CamLock: " .. tName
                btn.TextColor3 = Color3.fromRGB(255, 255, 255)
                local stroke = btn:FindFirstChildOfClass("UIStroke")
                if stroke then stroke.Color = Color3.fromRGB(255, 255, 255) end
            end
        end

        if camLockConn then camLockConn:Disconnect() end
        camLockConn = RunService.RenderStepped:Connect(function()
            local cam = workspace.CurrentCamera
            if camLockLocked and cam and camLockTarget and camLockTarget.Parent and camLockTarget.Parent:FindFirstChild("Humanoid") and camLockTarget.Parent.Humanoid.Health > 0 then
                local pred = Settings.camLockPrediction or 0.163186
                local vel = camLockTarget.AssemblyLinearVelocity or camLockTarget.Velocity or Vector3.zero
                cam.CFrame = CFrame.new(
                    cam.CFrame.Position,
                    camLockTarget.Position + (vel * pred)
                )
            else
                stopCamLockTracking()
            end
        end)
        registerConnection(camLockConn)
    end

    local function toggleCamLockTracking()
        if camLockLocked then
            stopCamLockTracking()
            notifyToggle("CamLock: OFF", false)
        else
            startCamLockTracking()
            if camLockLocked then
                notifyToggle("CamLock: ON", true)
            end
        end
    end

    local function createCamLockWidget()
        if CamLockGui and CamLockGui.Parent then CamLockGui:Destroy() end
        local gui = Instance.new("ScreenGui")
        gui.Name = "SacredCamLockWidget"
        gui.ResetOnSpawn = false
        safeParent(gui)
        CamLockGui = gui

        local btn = Instance.new("TextButton", gui)
        btn.Name = "CamLockButton"
        btn.Size = UDim2.new(0, 170, 0, 42)
        btn.Position = UDim2.new(0.5, -85, 0.22, 0)
        btn.BackgroundColor3 = Color3.fromRGB(14, 14, 18)
        btn.BackgroundTransparency = 0.35
        btn.TextColor3 = Color3.fromRGB(180, 180, 180)
        btn.Text = "CamLock: OFF"
        btn.Font = Enum.Font.GothamBold
        btn.TextSize = 13.5
        btn.Active = true
        btn.Draggable = true

        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)
        local stroke = Instance.new("UIStroke", btn)
        stroke.Thickness = 1.5
        stroke.Color = Color3.fromRGB(48, 48, 55)
        stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border

        btn.MouseButton1Click:Connect(function()
            toggleCamLockTracking()
        end)
    end

    local function destroyCamLockWidget()
        stopCamLockTracking()
        if CamLockGui and CamLockGui.Parent then
            CamLockGui:Destroy()
            CamLockGui = nil
        end
    end

    FeatureCallbacks["CamLock"] = function(v)
        if v then
            createCamLockWidget()
            notifyToggle("CamLock: ON", true)
        else
            destroyCamLockWidget()
            notifyToggle("CamLock: OFF", false)
        end
    end

    FeatureCallbacks["SwitchCamLock"] = function()
        if not FeatureStates["CamLock"] then
            setFeatureState("CamLock", true)
            if FeatureCallbacks["CamLock"] then FeatureCallbacks["CamLock"](true) end
        end
        toggleCamLockTracking()
    end
end

