local function getClientPing()
    local ping = 60
    pcall(function()
        local stats = game:GetService("Stats")
        local net = stats:FindFirstChild("Network")
        local item = net and net:FindFirstChild("ServerStatsItem") and net.ServerStatsItem:FindFirstChild("Data Ping")
        if item then
            local str = item:GetValueString()
            local num = tonumber(str:match("[%d%.]+"))
            if num then ping = num end
        else
            local ps = stats:FindFirstChild("PerformanceStats")
            local p = ps and ps:FindFirstChild("Ping")
            if p then ping = p:GetValue() end
        end
    end)
    return math.clamp(ping, 10, 800)
end

local function getToolCategory(tool)
    if not tool then return "Melee" end
    local tName = string.lower(tool.Name)
    local tt = ""
    pcall(function() tt = string.lower(tool.ToolTip or tool:GetAttribute("Type") or tool:GetAttribute("WeaponType") or "") end)

    if string.find(tt, "sword") or string.find(tt, "espada") then return "Sword" end
    if string.find(tt, "gun") or string.find(tt, "pistola") or string.find(tt, "arma") then return "Gun" end
    if string.find(tt, "fruit") or string.find(tt, "bloxfruit") or string.find(tt, "fruta") then return "Fruit" end
    if string.find(tt, "melee") or string.find(tt, "combat") then return "Melee" end

    local swordKeywords = {
        "sword", "blade", "katana", "yoru", "cursed", "scythe", "saber", "pole", "bisento",
        "trident", "dagger", "anchor", "lamp", "tushita", "yama", "rengoku", "wando", "shisui",
        "saddi", "canvander", "cavander", "koko", "cane", "jitte", "pipe", "mace", "cutlass",
        "hallow", "warden", "dragon trident", "spikey trident", "dark blade", "triple katana", "dual katana"
    }
    for _, sk in ipairs(swordKeywords) do
        if string.find(tName, sk) then return "Sword" end
    end

    local gunKeywords = {
        "guitar", "rifle", "flintlock", "kabucha", "slingshot", "bazooka", "cannon", "gun",
        "serpent bow", "bow", "acidum", "musket", "bizarre"
    }
    for _, gk in ipairs(gunKeywords) do
        if string.find(tName, gk) then return "Gun" end
    end

    local isFruit = string.find(tName, "fruit") or tool:FindFirstChild("Fruit") ~= nil
    if not isFruit and string.find(tName, "-") then
        local firstPart, secondPart = tName:match("^([%w%s]+)%-(%w+)$")
        if firstPart and secondPart and (firstPart:find(secondPart) or secondPart:find(firstPart)) then
            isFruit = true
        end
    end
    local fruitKeywords = {
        "portal", "dough", "dragon", "leopard", "kitsune", "buddha", "t-rex", "trex",
        "mammoth", "sound", "blizzard", "spirit", "venom", "shadow", "control", "gravity",
        "rumble", "paw", "spider", "love", "quake", "magma", "light", "ice", "flame",
        "dark", "sand", "falcon", "diamond", "rubber", "barrier", "ghost", "spin", "chop",
        "spring", "bomb", "smoke", "rocket"
    }
    if not isFruit then
        for _, kw in ipairs(fruitKeywords) do
            if string.find(tName, kw) then
                isFruit = true
                break
            end
        end
    end
    if isFruit then return "Fruit" end

    return "Melee"
end

