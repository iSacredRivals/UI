    local SuperJumpGui = nil
    local isSuperJumping = false

    local function doSuperJump()
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum or hum.Health <= 0 then return end

        hum.PlatformStand = false
        hum.Sit = false

        local jumpHeight = math.clamp(Settings.superJumpHeight or 500, 150, 1500)
        local curV = hrp.AssemblyLinearVelocity
        local moveDir = hum.MoveDirection
        local hSpeed = 45
        local targetX = (moveDir.Magnitude > 0.1) and (moveDir.X * hSpeed) or curV.X
        local targetZ = (moveDir.Magnitude > 0.1) and (moveDir.Z * hSpeed) or curV.Z

        hrp.AssemblyLinearVelocity = Vector3.new(targetX, jumpHeight, targetZ)
        hum:ChangeState(Enum.HumanoidStateType.Jumping)

        if not isSuperJumping then
            isSuperJumping = true
            task.spawn(function()
                local t0 = tick()
                local apex = false
                while tick() - t0 < 8 do
                    task.wait(0.06)
                    local c = LocalPlayer.Character
                    local h = c and c:FindFirstChild("HumanoidRootPart")
                    local hm = c and c:FindFirstChildOfClass("Humanoid")
                    if not h or not hm or hm.Health <= 0 then break end

                    local velY = h.AssemblyLinearVelocity.Y
                    if velY < 0 then apex = true end

                    if apex and velY < -60 then
                        local params = RaycastParams.new()
                        params.FilterDescendantsInstances = { c }
                        params.FilterType = Enum.RaycastFilterType.Exclude
                        local ray = workspace:Raycast(h.Position, Vector3.new(0, -35, 0), params)
                        if ray then
                            h.AssemblyLinearVelocity = Vector3.new(h.AssemblyLinearVelocity.X, -20, h.AssemblyLinearVelocity.Z)
                            hm.PlatformStand = false
                            hm.Sit = false
                            hm:ChangeState(Enum.HumanoidStateType.Running)
                            break
                        end
                    end

                    if apex and (hm.FloorMaterial ~= Enum.Material.Air or hm:GetState() == Enum.HumanoidStateType.Landed) then
                        hm.PlatformStand = false
                        hm.Sit = false
                        hm:ChangeState(Enum.HumanoidStateType.Running)
                        break
                    end
                end

                local c = LocalPlayer.Character
                local hm = c and c:FindFirstChildOfClass("Humanoid")
                if hm and hm.Health > 0 then
                    hm.PlatformStand = false
                    hm.Sit = false
                    if hm:GetState() == Enum.HumanoidStateType.Freefall or hm:GetState() == Enum.HumanoidStateType.PlatformStanding or hm:GetState() == Enum.HumanoidStateType.Physics then
                        hm:ChangeState(Enum.HumanoidStateType.Running)
                    end
                end
                isSuperJumping = false
            end)
        end
    end

