            if v and v.Name == "ErrorPrompt" then
                pcall(function()
                    v.Visible = false
                end)
                task.spawn(function()
                    task.wait(1)
                    quickHopLowestPing()
                end)
            end
        end
        for _, v in ipairs(promptOverlay:GetChildren()) do dismiss(v) end
        promptOverlay.ChildAdded:Connect(dismiss)
    end)
    pcall(function()
        TeleportService.TeleportInitFailed:Connect(function(player, teleportResult, errorMessage)
            notifyToggle("Teleport init failed. Retrying best server...", false)
            task.delay(1.5, function()
                quickHopLowestPing()
            end)
        end)
    end)
end

local function checkInCombat()
    local inCombat = false
    pcall(function()
        local pGui = LocalPlayer:FindFirstChild("PlayerGui")
        local main = pGui and pGui:FindFirstChild("Main")
        local bList = main and main:FindFirstChild("BottomHUDList")
        local ic = bList and bList:FindFirstChild("InCombat")
        if ic and ic.Visible and ic.Text and (string.find(string.lower(ic.Text), "risk") or string.find(string.lower(ic.Text), "combat")) then
            inCombat = true
        end
    end)
    return inCombat
end

local isTeleporting = false
local function teleportToServer(jobId)
    if not jobId or jobId == "" or jobId == game.JobId then return end
    if isTeleporting then return end

    if checkInCombat() then
        notifyToggle("Cannot hop: In Combat (Wait for PvP tag to clear)", false)
        return
    end

    isTeleporting = true
    enableAntiTeleportFail()
    notifyToggle("Connecting to server: " .. string.sub(tostring(jobId), 1, 8) .. "...", true)

    -- Method 1: Direct engine TeleportToPlaceInstance (Universal Roblox engine method)
    local ok = pcall(function()
        TeleportService:TeleportToPlaceInstance(game.PlaceId, tostring(jobId), LocalPlayer)
    end)

    -- Method 2: If engine call threw an error, invoke Blox Fruits remote
    if not ok then
        pcall(function()
            local sb = ReplicatedStorage:FindFirstChild("__ServerBrowser")
            if sb then
                sb:InvokeServer("teleport", tostring(jobId))
            end
        end)
    end

    task.delay(6, function()
        isTeleporting = false
    end)
end

local function rejoinCurrentServer()
    enableAntiTeleportFail()
    notifyToggle("Rejoining game...", true)
    local ok = false
    pcall(function()
        TeleportService:Teleport(game.PlaceId, LocalPlayer)
        ok = true
    end)
    if not ok then
        pcall(function()
            local sb = ReplicatedStorage:FindFirstChild("__ServerBrowser")
            if sb then
                sb:InvokeServer("teleport", game.JobId)
            end
        end)
    end
end

