    local function GetClosestEnemy()
        local enemiesFolder = workspace:FindFirstChild("Enemies")
        if not enemiesFolder then return nil end
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return nil end
        local myPos = hrp.Position

        local bossAlive = false
        for _, obj in ipairs(enemiesFolder:GetChildren()) do
            if obj:IsA("Model") and not Players:GetPlayerFromCharacter(obj) then
                local nl = string.lower(obj.Name)
                if string.find(nl, "gas knight") or string.find(nl, "kitsune") or string.find(nl, "captain") then
                    local hum = obj:FindFirstChildOfClass("Humanoid")
                    if hum and hum.Health > 0 then
                        bossAlive = true
                        break
                    end
                end
            end
        end

        local closestEnemy = nil
        local shortestDistance = math.huge

        for _, obj in ipairs(enemiesFolder:GetChildren()) do
            if obj:IsA("Model") and obj ~= char and not Players:GetPlayerFromCharacter(obj) then
                if obj.Name == "PropHitboxPlaceholder" and not bossAlive then
                    continue
                end
                if obj.Name == "Blank Buddy" or obj.Name == "Sombra" or obj.Name == "Shadow" then
                    continue
                end

                local hum = obj:FindFirstChildOfClass("Humanoid")
                local root = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Head") or obj:FindFirstChildOfClass("BasePart")
                if hum and hum.Health > 0 and root and obj.Parent then
                    local dist = (root.Position - myPos).Magnitude
                    local nl = string.lower(obj.Name)
                    if string.find(nl, "gas knight") or string.find(nl, "kitsune") or string.find(nl, "captain") then
                        dist = dist - 1000
                    end
                    if dist < shortestDistance then
                        shortestDistance = dist
                        closestEnemy = obj
                    end
                end
            end
        end
        return closestEnemy
    end

    local function AttackEnemy(enemy)
        if not enemy or not enemy.Parent then return end
        local char = LocalPlayer.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        local enemyRoot = enemy:FindFirstChild("HumanoidRootPart") or enemy:FindFirstChild("Head") or enemy:FindFirstChildOfClass("BasePart")
        local enemyHum = enemy:FindFirstChildOfClass("Humanoid")
        if not enemyRoot or not enemyHum or enemyHum.Health <= 0 then return end

        ensureDungeonFloat(hrp)
        hrp.CFrame = CFrame.new(enemyRoot.Position + Vector3.new(0, attackHeight, 0), enemyRoot.Position)
        hrp.AssemblyLinearVelocity = Vector3.zero
        setCharacterNoclip(char)

        local tool = char:FindFirstChildOfClass("Tool")
        if tool then tool:Activate() end

        local regAttack, regHit = resolveDungeonRemotes()
        if regAttack and regHit then
            pcall(function()
                regAttack:FireServer(0)
                regHit:FireServer(enemyRoot, { { enemy, enemyRoot } })
            end)
        end
    end

    local function AutoPassRoom()
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return false end

        removeDungeonFloat(hrp)

        local mapFolder = workspace:FindFirstChild("Map")
        local dungeonFolder = mapFolder and mapFolder:FindFirstChild("Dungeon")
        if dungeonFolder then
            local rooms = dungeonFolder:GetChildren()
            if #rooms > 0 then
                table.sort(rooms, function(a, b)
                    local numA = tonumber(string.match(a.Name, "%d+")) or 0
                    local numB = tonumber(string.match(b.Name, "%d+")) or 0
                    return numA < numB
                end)

                local myPos = hrp.Position
                local currentRoomIdx = 1
                local minDistance = math.huge
                for i, r in ipairs(rooms) do
                    local rPart = r:FindFirstChildOfClass("BasePart") or r:FindFirstChild("Floor")
                    if rPart then
                        local d = (rPart.Position - myPos).Magnitude
                        if d < minDistance then
                            minDistance = d
                            currentRoomIdx = i
                        end
                    end
                end

                local activeRoom = rooms[currentRoomIdx] or rooms[1]
                local tp = activeRoom:FindFirstChild("ExitTeleporter") or activeRoom:FindFirstChild("Teleporter") or activeRoom:FindFirstChild("Exit")
                if not tp then
                    for _, child in ipairs(activeRoom:GetDescendants()) do
                        if child:IsA("BasePart") and string.find(string.lower(child.Name), "exit") then
                            tp = child
                            break
                        end
                    end
                end

                if tp then
                    local rootPart = tp:FindFirstChild("Root") or (tp:IsA("BasePart") and tp) or tp:FindFirstChildOfClass("BasePart")
                    if rootPart and rootPart:IsA("BasePart") then
                        hrp.CFrame = rootPart.CFrame + Vector3.new(0, 1, 0)
                        task.wait(0.1)
                        if firetouchinterest then
                            firetouchinterest(hrp, rootPart, 0)
                            task.wait(0.08)
                            firetouchinterest(hrp, rootPart, 1)
                        end
                        return true
                    end
                end
            end
        end

        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("TouchTransmitter") and obj.Parent and obj.Parent:IsA("BasePart") then
                local pName = string.lower(obj.Parent.Name)
                if string.find(pName, "exit") or string.find(pName, "teleport") then
                    hrp.CFrame = obj.Parent.CFrame + Vector3.new(0, 1, 0)
                    task.wait(0.1)
                    if firetouchinterest then
                        firetouchinterest(hrp, obj.Parent, 0)
                        task.wait(0.08)
                        firetouchinterest(hrp, obj.Parent, 1)
                    end
                    return true
                end
            end
        end

        return false
    end

