local function updateMobileScaling()
    local camera = workspace.CurrentCamera
    if not camera then return end
    local viewport = camera.ViewportSize
    local scaleX = (viewport.X * 0.88) / 800
    local scaleY = (viewport.Y * 0.86) / 450
    local minScale = math.min(scaleX, scaleY, 1)
    UIScale.Scale = math.clamp(minScale * 0.92, 0.30, 0.76)
end

