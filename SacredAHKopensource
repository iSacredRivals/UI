do
    local SacredVFXPage = createScrollPage("SacredVFX_Page", 380)

    local VFX_ON = false
    local TRANSFORM_ON = false
    local SWORD_ON = false
    local IS_RAINBOW = false
    local INCLUDE_GENERIC = false
    local SLOT2_ICON_ON = false

    local CURRENT_COLOR = Color3.fromRGB(255, 0, 0)
    local CURRENT_SEQ = ColorSequence.new(CURRENT_COLOR)
    local CURRENT_ASSET = "rbxassetid://82169952275337"

    local animatedParts = {}
    local originalColors = {}
    local savedSurfaceAppearances = {}
    local savedTextureIDs = {}
    local activeConnections = {}

    local function cleanupVFX()
        for _, c in ipairs(activeConnections) do
            pcall(function() c:Disconnect() end)
        end
        table.clear(activeConnections)

        for sa, parent in pairs(savedSurfaceAppearances) do
            pcall(function()
                if sa and parent and parent.Parent then sa.Parent = parent end
            end)
        end
        table.clear(savedSurfaceAppearances)

        for mesh, tex in pairs(savedTextureIDs) do
            pcall(function()
                if mesh and mesh.Parent then mesh.TextureID = tex end
            end)
        end
        table.clear(savedTextureIDs)

        for part, props in pairs(originalColors) do
            pcall(function()
                if part and part.Parent then
                    part.Color = props.Color
                    part.Material = props.Material
                end
            end)
        end
        table.clear(originalColors)
        table.clear(animatedParts)
    end
    getgenv().SacredColorVFX_Cleanup = cleanupVFX

    local TRANSFORM_WORDS = { "transform", "dragon", "kitsune", "buddha", "mammoth", "leopard", "phoenix", "t-rex", "venom", "shadow", "falcon", "diamond" }
    local SWORD_WORDS = { "sword", "blade", "katana", "saber", "cutlass", "scythe", "pole", "trident", "dagger", "yoru", "true triple", "cursed dual", "hallow scythe", "shark anchor" }
    local SKILL_WORDS = { "skill", "vfx", "effect", "aura", "slash", "hit", "burst", "charge", "magic", "circle", "energy", "particle", "flash", "beam", "wave", "impact", "flame", "fire", "lightning", "water", "ice", "dark", "light" }

    local function isVEnvironment(child)
        local name = string.lower(child.Name)
        if name:find("varena") or name:find("mainvortex") or name:find("v_dimension") then return true end
        local p = child.Parent
        while p and p ~= workspace and p ~= game do
            local pn = string.lower(p.Name)
            if pn:find("varena") or pn:find("mainvortex") then return true end
            p = p.Parent
        end
        return false
    end

    local function isTransformPart(child)
        local char = LocalPlayer.Character
        if not char then return false end
        if not child:IsDescendantOf(char) then return false end
        local name = string.lower(child.Name)
        for _, kw in ipairs(TRANSFORM_WORDS) do
            if string.find(name, kw, 1, true) then return true end
        end
        return false
    end

    local function isSwordPart(child)
        local char = LocalPlayer.Character
        if not char then return false end
        if not child:IsDescendantOf(char) then return false end
        local name = string.lower(child.Name)
        for _, kw in ipairs(SWORD_WORDS) do
            if string.find(name, kw, 1, true) then return true end
        end
        return false
    end

    local function isSkillOrVFX(child)
        if child:IsA("SurfaceAppearance") then return true end
        if child:IsA("MeshPart") and child:FindFirstChildWhichIsA("SurfaceAppearance") then return true end
        local name = string.lower(child.Name)
        for _, kw in ipairs(SKILL_WORDS) do
            if string.find(name, kw, 1, true) then return true end
        end
        if INCLUDE_GENERIC then
            if child:IsA("ParticleEmitter") or child:IsA("Beam") or child:IsA("Trail") or child:IsA("PointLight") then
                return true
            end
        end
        return false
    end

    local function applyVFX(child)
        if not VFX_ON then return end
        pcall(function()
            local shouldColor = false
            if TRANSFORM_ON and isTransformPart(child) then shouldColor = true end
            if SWORD_ON and isSwordPart(child) then shouldColor = true end
            if isSkillOrVFX(child) then shouldColor = true end
            if isVEnvironment(child) then shouldColor = true end

            if not shouldColor then return end

            if child:IsA("SurfaceAppearance") then
                if not savedSurfaceAppearances[child] then
                    savedSurfaceAppearances[child] = child.Parent
                    child.Parent = nil
                end
                return
            end

            if child:IsA("MeshPart") then
                local sa = child:FindFirstChildWhichIsA("SurfaceAppearance")
                if sa and not savedSurfaceAppearances[sa] then
                    savedSurfaceAppearances[sa] = child
                    sa.Parent = nil
                end
                if not savedTextureIDs[child] then
                    savedTextureIDs[child] = child.TextureID
                end
                child.TextureID = ""
                if not originalColors[child] then
                    originalColors[child] = { Color = child.Color, Material = child.Material }
                end
                child.Material = Enum.Material.Neon
                child.Color = CURRENT_COLOR
                if IS_RAINBOW then animatedParts[child] = true end
                return
            end

            if child:IsA("BasePart") then
                if not originalColors[child] then
                    originalColors[child] = { Color = child.Color, Material = child.Material }
                end
                child.Material = Enum.Material.Neon
                child.Color = CURRENT_COLOR
                if IS_RAINBOW then animatedParts[child] = true end
                return
            end

            if child:IsA("ParticleEmitter") or child:IsA("Beam") or child:IsA("Trail") then
                child.Color = CURRENT_SEQ
                return
            end

            if child:IsA("PointLight") or child:IsA("SpotLight") or child:IsA("SurfaceLight") then
                child.Color = CURRENT_COLOR
                return
            end
        end)
    end

    local function refreshVFX()
        cleanupVFX()
        if not VFX_ON then return end
        for _, obj in ipairs(workspace:GetDescendants()) do
            applyVFX(obj)
        end
        local conn = workspace.DescendantAdded:Connect(function(child)
            task.defer(applyVFX, child)
        end)
        table.insert(activeConnections, conn)
    end

    local function updateInventoryIcon()
        pcall(function()
            local pGui = LocalPlayer:FindFirstChild("PlayerGui")
            if not pGui then return end
            local backpackGui = pGui:FindFirstChild("Main") or pGui:FindFirstChild("Backpack") or pGui:FindFirstChild("HotbarGui") or pGui:FindFirstChildWhichIsA("ScreenGui")
            if not backpackGui then return end
            local hotbar = backpackGui:FindFirstChild("Hotbar", true) or backpackGui:FindFirstChild("Container", true)
            if not hotbar then return end
            local container = hotbar:FindFirstChild("Container") or hotbar

            local frames = {}
            for _, child in ipairs(container:GetChildren()) do
                if child:IsA("GuiObject") and child.Name ~= "UIGridLayout" and child.Name ~= "UIListLayout" then
                    table.insert(frames, child)
                end
            end

            for idx, slot in ipairs(frames) do
                local border = slot:FindFirstChild("Border") or slot
                local existing = border:FindFirstChild("SacredPortalIcon")
                local isSlot2 = (slot.Name == "2" or slot.LayoutOrder == 2 or idx == 2)

                if SLOT2_ICON_ON and isSlot2 then
                    if not existing then
                        existing = Instance.new("ImageLabel")
                        existing.Name = "SacredPortalIcon"
                        existing.Size = UDim2.new(1, 0, 1, 0)
                        existing.Position = UDim2.new(0, 0, 0, 0)
                        existing.BackgroundTransparency = 1
                        existing.ZIndex = 10
                        existing.Parent = border
                    end
                    existing.Image = CURRENT_ASSET
                    existing.Visible = true
                else
                    if existing then existing:Destroy() end
                end
            end
        end)
    end

    task.spawn(function()
        while isCurrentSession() do
            task.wait(0.5)
            if SLOT2_ICON_ON then
                pcall(updateInventoryIcon)
            end
        end
    end)

    task.spawn(function()
        local hue = 0
        while isCurrentSession() do
            task.wait(0.04)
            if VFX_ON and IS_RAINBOW then
                hue = (hue + 0.015) % 1
                local rainbowCol = Color3.fromHSV(hue, 0.85, 1)
                CURRENT_COLOR = rainbowCol
                CURRENT_SEQ = ColorSequence.new(rainbowCol)
                for part, _ in pairs(animatedParts) do
                    if part and part.Parent then
                        part.Color = rainbowCol
                    else
                        animatedParts[part] = nil
                    end
                end
            end
        end
    end)

    local sc1 = makeCard(SacredVFXPage, "Sacred Color VFX Settings", "Ajustes Sacred VFX", 168, 2)

    local BW = UDim2.new(0, 168, 0, 30)
    local X1 = 8
    local X2 = 186
    local X3 = 364

    local masterBtn = nil
    masterBtn = createActionButton(sc1, "Master VFX: OFF", "Master VFX: OFF", BW, UDim2.new(0, X1, 0, 26), function()
        VFX_ON = not VFX_ON
        masterBtn.Text = VFX_ON and "Master VFX: ON" or "Master VFX: OFF"
        masterBtn.BackgroundColor3 = VFX_ON and Color3.fromRGB(42, 42, 58) or Color3.fromRGB(24, 24, 30)
        refreshVFX()
        notifyToggle("Sacred VFX: " .. (VFX_ON and "ON" or "OFF"), VFX_ON)
    end)

    local transBtn = nil
    transBtn = createActionButton(sc1, "Transformations: OFF", "Transformaciones: OFF", BW, UDim2.new(0, X2, 0, 26), function()
        TRANSFORM_ON = not TRANSFORM_ON
        transBtn.Text = TRANSFORM_ON and "Transformations: ON" or "Transformations: OFF"
