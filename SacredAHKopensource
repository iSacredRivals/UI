local function httpGetRaw(url)
    local req = (syn and syn.request) or (http and http.request) or http_request or (fluxus and fluxus.request) or request
    if req then
        local ok, r = pcall(function()
            return req({
                Url = url,
                Method = "GET",
                Headers = {
                    ["User-Agent"] = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
                }
            })
        end)
        if ok and r and r.Body then return r.Body end
    end
    if game.HttpGet then
        local ok, res = pcall(function() return game:HttpGet(url) end)
        if ok and res and #res > 0 then return res end
    end
    return nil
end

local function fetchBestServers(onComplete)
    if isFetchingServers then
        if onComplete then onComplete(cachedServerList or {}) end
        return
    end
    isFetchingServers = true

    task.spawn(function()
        local serverList = {}
        local seenIds = {}

        local function finalize()
            table.sort(serverList, function(a, b)
                local pingA = (a.ping and a.ping > 0) and a.ping or 999
                local pingB = (b.ping and b.ping > 0) and b.ping or 999
                if pingA ~= pingB then
                    return pingA < pingB
                end
                return a.playing < b.playing
            end)
            cachedServerList = serverList
            isFetchingServers = false
            if onComplete then pcall(onComplete, serverList) end
        end

        pcall(function()
            local sbGui = LocalPlayer:FindFirstChild("PlayerGui") and LocalPlayer.PlayerGui:FindFirstChild("ServerBrowser")
            if sbGui and sbGui:FindFirstChild("Frame") and sbGui.Frame:FindFirstChild("Filters") and sbGui.Frame.Filters:FindFirstChild("SearchRegion") then
                sbGui.Frame.Filters.SearchRegion.TextBox.Text = (selectedServerRegion == "Auto") and "" or selectedServerRegion
            end
        end)

        -- 1. Primary: Roblox Public Games API with real Ping and FPS
        pcall(function()
            local url = "https://games.roblox.com/v1/games/" .. tostring(game.PlaceId) .. "/servers/Public?sortOrder=Asc&limit=100&excludeFullGames=true"
            local res = httpGetRaw(url)
            if res then
                local parsed = HttpService:JSONDecode(res)
                if parsed and parsed.data then
                    for _, s in ipairs(parsed.data) do
                        if s.id and s.id ~= game.JobId and not seenIds[s.id] then
                            local playing = tonumber(s.playing) or 0
                            local maxPlayers = tonumber(s.maxPlayers) or 12
                            local ping = tonumber(s.ping) or 0
                            local fps = tonumber(s.fps) or 60
                            if playing < maxPlayers then
                                seenIds[s.id] = true
                                table.insert(serverList, {
                                    id = tostring(s.id),
                                    playing = playing,
                                    maxPlayers = maxPlayers,
                                    ping = ping,
                                    fps = math.floor(fps + 0.5),
                                    region = selectedServerRegion
                                })
                            end
                        end
                    end
                end
            end
        end)

        -- 2. Fallback: If HTTP empty or blocked, query Blox Fruits native __ServerBrowser Remote
        if #serverList == 0 then
            pcall(function()
                local sb = ReplicatedStorage:FindFirstChild("__ServerBrowser")
                if sb then
                    for page = 1, 6 do
                        local ok, data = pcall(function() return sb:InvokeServer(page) end)
                        if ok and type(data) == "table" then
                            for k, v in pairs(data) do
                                if type(v) == "table" and k ~= game.JobId and not seenIds[k] then
                                    local cnt = tonumber(v.Count) or 0
                                    if cnt > 0 and cnt < 12 then
                                        seenIds[k] = true
                                        table.insert(serverList, {
                                            id = tostring(k),
                                            playing = cnt,
                                            maxPlayers = 12,
                                            ping = 0,
                                            fps = 60,
                                            region = selectedServerRegion
                                        })
                                    end
                                end
                            end
                        end
                    end
                end
            end)
        end

        finalize()
    end)
end

local function quickHopLowestPing(maxCount)
    local maxC = maxCount or maxPlayerServerFilter or 10
    notifyToggle("Searching lowest ping server (<= " .. tostring(maxC) .. " players)...", true)

    fetchBestServers(function(servers)
        local candidates = {}
        for _, s in ipairs(servers) do
            if s.id ~= game.JobId and s.playing <= maxC and s.playing > 0 then
                table.insert(candidates, s)
            end
        end

        if #candidates > 0 then
            local best = candidates[1] -- First candidate is lowest ping
            local pingDisp = (best.ping and best.ping > 0) and (tostring(best.ping) .. " ms") or "Fast"
            notifyToggle(string.format("Joining #1 Server (%s) | Ping: %s | %d/%d Players", string.sub(best.id, 1, 8), pingDisp, best.playing, best.maxPlayers), true)
            teleportToServer(best.id)
        else
            notifyToggle("No servers found matching filter, hopping to best available...", false)
            if #servers > 0 and servers[1].id ~= game.JobId then
                teleportToServer(servers[1].id)
            else
                rejoinCurrentServer()
            end
        end
    end)
end

