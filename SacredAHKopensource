    if aimbotOn and PlayersPosition then

        task.spawn(function() faceTarget(PlayersPosition) end)

    end

    task.spawn(function()

        local myTime = lastSkillTime

        task.wait(1.5)

        if lastSkillTime == myTime and currentSkillKey == key then

            currentSkillKey = nil

        end

    end)

end



