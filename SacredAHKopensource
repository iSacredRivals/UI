    local function AX_ReadPvPState(target)
        if not target then return false end
        local ok, pvpOn = pcall(function()
            local isPlr = pcall(function() return target:IsA("Player") end) and target:IsA("Player")
            if isPlr and target:GetAttribute("PvpDisabled") == true then
                return false
            end
            local char = (isPlr and target.Character) or target
            if char then
                local hasFF = pcall(function() return char:FindFirstChildOfClass("ForceField") end) and char:FindFirstChildOfClass("ForceField")
                if hasFF then return false end
                local dis = pcall(function() return char:GetAttribute("PvpDisabled") end) and char:GetAttribute("PvpDisabled")
                if dis == true then return false end
            end
            return true
        end)
        return ok and pvpOn == true
    end

    local cachedSafeZones = {}
    local lastSafeZoneScan = 0
    local function getCachedSafeZones()
        if tick() - lastSafeZoneScan > 4 then
            lastSafeZoneScan = tick()
            table.clear(cachedSafeZones)
            pcall(function()
                local wo = Workspace:FindFirstChild("_WorldOrigin")
                local sz = wo and wo:FindFirstChild("SafeZones")
                if sz then
                    for _, zone in ipairs(sz:GetChildren()) do
                        if zone:IsA("BasePart") then
                            local r = math.min(zone.Size.X, zone.Size.Z) / 2
                            if r > 500 or r <= 0 then r = 350 end
                            table.insert(cachedSafeZones, { pos = zone.Position, radius = r })
                        end
                    end
                end
            end)
        end
        return cachedSafeZones
    end

    local function AX_InSafeZone(target)
        if not target then return false end
        local ok, inZone = pcall(function()
            local isPlr = pcall(function() return target:IsA("Player") end) and target:IsA("Player")
            local char = (isPlr and target.Character) or target
            if not char then return false end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then return false end

            local hasFF = pcall(function() return char:FindFirstChildOfClass("ForceField") end) and char:FindFirstChildOfClass("ForceField")
            if hasFF then return true end
            if char:GetAttribute("SafeZone") == true then return true end
            if isPlr and target:GetAttribute("SafeZone") == true then return true end

            local zones = getCachedSafeZones()
            for _, z in ipairs(zones) do
                if (hrp.Position - z.pos).Magnitude <= z.radius then
                    return true
                end
            end
            return false
        end)
        return ok and inZone == true
    end

    local function getClosestPlayer(maxDist)
        local char = LocalPlayer.Character
        local myHrp = char and char:FindFirstChild("HumanoidRootPart")
        if not myHrp then return nil end
        local myPos = myHrp.Position
        local maxD = maxDist or 800

        local closestChar, closestDist = nil, maxD
        local closestEnemy, closestEnemyDist = nil, maxD

        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:IsDescendantOf(workspace) then
                local pChar = p.Character
                local hum = pChar:FindFirstChildOfClass("Humanoid")
                local hrp = pChar:FindFirstChild("HumanoidRootPart") or pChar.PrimaryPart or pChar:FindFirstChild("UpperTorso")
                if hum and hum.Health > 0 and hrp and hrp.Position.Y > -500 then
                    local dist = (hrp.Position - myPos).Magnitude
                    if dist < maxD then
                        if dist < closestDist then
                            closestChar = pChar
                            closestDist = dist
                        end

                        if isEnemy(p) and not AX_InSafeZone(p) and AX_ReadPvPState(p) then
                            if dist < closestEnemyDist then
                                closestEnemy = pChar
                                closestEnemyDist = dist
                            end
                        end
                    end
                end
            end
        end

        if closestEnemy and closestEnemyDist <= math.min(closestDist * 2.5, 400) then
            return closestEnemy
        end
        return closestChar or closestEnemy
    end

    local function getClosestNPC(maxDist)
