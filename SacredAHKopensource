local function CheckNearestTeleporter(targetPos)
    local pos = typeof(targetPos) == "CFrame" and targetPos.Position or targetPos
    local minDist = math.huge
    local nearest = nil
    local placeId = game.PlaceId
    local teleporters = {}

    if placeId == 7449423635 or placeId == 100117331123089 then
        teleporters = {
            ["Floating Turtle"] = Vector3.new(-12462, 375, -7552),
            ["Hydra Island"] = Vector3.new(5657.88, 1013.08, -335.50),
            Mansion = Vector3.new(-12462, 375, -7552),
            Castle = Vector3.new(-5036, 315, -3179),
            ["Temple of Time"] = Vector3.new(28286, 14897, 103)
        }
    elseif placeId == 4442272183 or placeId == 79091703265657 then
        teleporters = {
            ["Swan Mansion"] = Vector3.new(-390, 332, 673),
            ["Swan Room"] = Vector3.new(2285, 15, 905),
            ["Cursed Ship"] = Vector3.new(923, 126, 32852),
            ["Zombie Island"] = Vector3.new(-6509, 83, -133)
        }
    else
        teleporters = {
            Sky3 = Vector3.new(-7894, 5547, -380),
            ["Underwater City"] = Vector3.new(61165.19, 0.19, 1897.38),
            ["Pirate Village"] = Vector3.new(-1242.46, 4.79, 3901.28)
        }
    end

    local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local myPos = myHrp and myHrp.Position or Vector3.zero
    for _, tpPos in pairs(teleporters) do
        local d = (tpPos - pos).Magnitude
        if d < minDist then
            minDist = d
            nearest = tpPos
        end
    end

    if minDist <= (pos - myPos).Magnitude - 150 then
        return nearest
    end
    return nil
end

local function stopIslandTween()
    isTweeningIsland = false
    activeTweenTargetName = nil
    if currentIslandTween then
        pcall(function() currentIslandTween:Cancel() end)
        currentIslandTween = nil
    end
    if islandNoclipConn then
        pcall(function() islandNoclipConn:Disconnect() end)
        islandNoclipConn = nil
    end
    local char = LocalPlayer.Character
    if char then
        local pt = char:FindFirstChild("PartTele")
        if pt then pcall(function() pt:Destroy() end) end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then hrp.AssemblyLinearVelocity = Vector3.zero end
    end
    if onIslandTweenStateChanged then onIslandTweenStateChanged(false) end
    notifyToggle("Island Tween: STOPPED (OFF)", false)
end

local function startIslandTween(targetCF, islandName)
    stopIslandTween()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or (type(hum.Health) == "number" and hum.Health <= 0) then return end

    isTweeningIsland = true
    activeTweenTargetName = islandName or "Island"
    if onIslandTweenStateChanged then onIslandTweenStateChanged(true, activeTweenTargetName) end
    notifyToggle("Tweening to " .. activeTweenTargetName .. " (ON)", true)

    -- Portal bypass check
    pcall(function()
        local nearest = CheckNearestTeleporter(targetCF)
        if nearest then
            game:GetService("ReplicatedStorage").Remotes.CommF_:InvokeServer("requestEntrance", nearest)
            task.wait(0.4)
        end
    end)

    if not isTweeningIsland then return end

    -- Noclip loop while tweening
    islandNoclipConn = RunService.Stepped:Connect(function()
        if not isTweeningIsland then
            if islandNoclipConn then islandNoclipConn:Disconnect(); islandNoclipConn = nil end
            return
        end
        local c = LocalPlayer.Character
        if c then
            for _, p in ipairs(c:GetDescendants()) do
                if p:IsA("BasePart") then p.CanCollide = false end
            end
        end
    end)

    -- Redz PartTele setup
    local partTele = char:FindFirstChild("PartTele")
    if not partTele then
        partTele = Instance.new("Part", char)
        partTele.Size = Vector3.new(10, 1, 10)
        partTele.Name = "PartTele"
        partTele.Anchored = true
        partTele.Transparency = 1
        partTele.CanCollide = false
        partTele.CFrame = hrp.CFrame
        partTele:GetPropertyChangedSignal("CFrame"):Connect(function()
            if isTweeningIsland and char and char:FindFirstChild("HumanoidRootPart") then
                char.HumanoidRootPart.CFrame = partTele.CFrame
                char.HumanoidRootPart.AssemblyLinearVelocity = Vector3.zero
            end
        end)
    end

    local dist = (targetCF.Position - hrp.Position).Magnitude
    local speed = 350
    local t = math.max(dist / speed, 0.1)

    currentIslandTween = TweenService:Create(partTele, TweenInfo.new(t, Enum.EasingStyle.Linear), { CFrame = targetCF })
    currentIslandTween:Play()

    pcall(function()
        if currentIslandTween and currentIslandTween.Completed and currentIslandTween.Completed.Connect then
            currentIslandTween.Completed:Connect(function(playbackState)
                if playbackState == Enum.PlaybackState.Completed then
                    stopIslandTween()
                    notifyToggle("Arrived at " .. (islandName or "Island") .. "!", true)
                end
            end)
        end
    end)
end

