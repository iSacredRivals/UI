    end

    local function removeDrawingObj(obj)
        if not obj then return end
        pcall(function() obj.Visible = false end)
        pcall(function()
            if obj.Remove then
                obj:Remove()
            elseif obj.Destroy then
                obj:Destroy()
            end
        end)
    end

    local function createDrawingLine()
        if not Drawing or not Drawing.new then return nil end
        local ok, line = pcall(function()
            local l = Drawing.new("Line")
            l.Visible = false
            l.Color = MATCHA_COLOR
            l.Thickness = 3.5
            l.Transparency = 1
            return l
        end)
        return ok and line or nil
    end

    local function createDrawingSquare()
        if not Drawing or not Drawing.new then return nil end
        local ok, sq = pcall(function()
            local s = Drawing.new("Square")
            s.Visible = false
            s.Color = MATCHA_COLOR
            s.Thickness = 2.8
            s.Filled = false
            s.Transparency = 1
            return s
        end)
        return ok and sq or nil
    end

    local function getTeamInfo(targetP)
        if not targetP or not targetP.Team then
            return "Neutral", Color3.fromRGB(220, 220, 220)
        end
        if targetP.Team.Name == "Marines" then
            return "Marines", Color3.fromRGB(0, 170, 255)
        else
            return "Pirates", Color3.fromRGB(255, 70, 70)
        end
    end

    local function getPlayerData(targetP)
        if not playerCache[targetP] then
            playerCache[targetP] = {
                level = "?",
                fruit = "None",
                bounty = 0,
                team = "Neutral",
                color = Color3.fromRGB(220, 220, 220),
                lastUpdate = 0
            }
        end
        local data = playerCache[targetP]
        local now = os.clock()
        if now - data.lastUpdate > 3 or data.level == "?" or data.fruit == "None" then
            pcall(function()
                local tName, tCol = getTeamInfo(targetP)
                data.team = tName
                data.color = tCol
                local d = targetP:FindFirstChild("Data")
                if d then
                    local lvl = d:FindFirstChild("Level")
                    if lvl and lvl.Value then data.level = tostring(lvl.Value) end
                    local fr = d:FindFirstChild("DevilFruit")
                    if fr and fr.Value then data.fruit = tostring(fr.Value) end
                end
                local ls = targetP:FindFirstChild("leaderstats")
                if ls then
                    local b = ls:FindFirstChild("Bounty/Honor") or ls:FindFirstChild("Bounty") or ls:FindFirstChild("Honor")
                    if b and b.Value then data.bounty = b.Value end
                    if data.level == "?" then
                        local l = ls:FindFirstChild("Level") or ls:FindFirstChild("Lvl")
                        if l and l.Value then data.level = tostring(l.Value) end
                    end
                end
                data.lastUpdate = now
            end)
        end
        return data
    end

