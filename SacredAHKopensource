        -- 1. BESPOKE ESP (General, Player, Rainbow)
        for p, data in pairs(bespokeESPStore) do
            pcall(function()
                if p.Parent and data.char and data.char.Parent and data.lbl and data.bb and data.bb.Parent then
                    local hrp = data.char:FindFirstChild("HumanoidRootPart") or data.char:FindFirstChild("Head")
