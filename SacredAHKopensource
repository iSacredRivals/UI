    local camLockTarget = nil

    local function findNearestCamLockEnemy()
        local dist = math.huge
        local screenCenter
        local ok, res = pcall(function() return GuiService:GetScreenResolution() end)
        if ok and res and res.X > 0 and res.Y > 0 then
            screenCenter = Vector2.new(res.X / 2, res.Y / 2)
        else
            local cam = workspace.CurrentCamera
            screenCenter = cam and Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2) or Vector2.new(640, 360)
        end

        local closestPart = nil
        local cam = workspace.CurrentCamera
        if not cam then return nil end

        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                local char = player.Character
                if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") then
                    if char.Humanoid.Health > 0 then
                        local partToLock = (Settings.camLockTargetPart == "Head" and char:FindFirstChild("Head")) or char.HumanoidRootPart
                        local pos, visible = cam:WorldToViewportPoint(partToLock.Position)
                        if visible then
                            local magnitude = (screenCenter - Vector2.new(pos.X, pos.Y)).Magnitude
                            if magnitude < dist then
                                closestPart = partToLock
                                dist = magnitude
                            end
                        end
                    end
                end
            end
        end
        return closestPart
    end

    local function stopCamLockTracking()
        if camLockConn then
            camLockConn:Disconnect()
            camLockConn = nil
        end
        camLockLocked = false
        camLockTarget = nil
        if CamLockGui and CamLockGui.Parent then
            local btn = CamLockGui:FindFirstChild("CamLockButton", true)
            if btn then
                btn.Text = "CamLock: OFF"
                btn.TextColor3 = Color3.fromRGB(180, 180, 180)
                local stroke = btn:FindFirstChildOfClass("UIStroke")
                if stroke then stroke.Color = Color3.fromRGB(48, 48, 55) end
            end
        end
    end

    local function startCamLockTracking()
        camLockTarget = findNearestCamLockEnemy()
        if not camLockTarget then
            stopCamLockTracking()
            notifyToggle("No visible enemy in view", false)
            return
        end

        camLockLocked = true
        if CamLockGui and CamLockGui.Parent then
            local btn = CamLockGui:FindFirstChild("CamLockButton", true)
            if btn then
                local tName = camLockTarget.Parent and camLockTarget.Parent.Name or "ON"
                if #tName > 10 then tName = string.sub(tName, 1, 9) .. ".." end
                btn.Text = "CamLock: " .. tName
                btn.TextColor3 = Color3.fromRGB(255, 255, 255)
                local stroke = btn:FindFirstChildOfClass("UIStroke")
                if stroke then stroke.Color = Color3.fromRGB(255, 255, 255) end
            end
        end

        if camLockConn then camLockConn:Disconnect() end
        camLockConn = RunService.RenderStepped:Connect(function()
            local cam = workspace.CurrentCamera
            if camLockLocked and cam and camLockTarget and camLockTarget.Parent and camLockTarget.Parent:FindFirstChild("Humanoid") and camLockTarget.Parent.Humanoid.Health > 0 then
                local pred = Settings.camLockPrediction or 0.163186
                local vel = camLockTarget.AssemblyLinearVelocity or camLockTarget.Velocity or Vector3.zero
                local targetPos = camLockTarget.Position + (vel * pred)
                if (targetPos - cam.CFrame.Position).Magnitude > 0.5 then
                    cam.CFrame = CFrame.lookAt(cam.CFrame.Position, targetPos)
                end
            else
                stopCamLockTracking()
            end
        end)
        registerConnection(camLockConn)
    end

    local function toggleCamLockTracking()
        if camLockLocked then
            stopCamLockTracking()
            notifyToggle("CamLock: OFF", false)
        else
            startCamLockTracking()
            if camLockLocked then
                notifyToggle("CamLock: ON", true)
            end
        end
    end

