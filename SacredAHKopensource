local isSacredTransparentActive = false
local currentGlassAlpha = 0.65

local function setSacredTransparentMode(enabled, alpha)
    isSacredTransparentActive = enabled
    if alpha then currentGlassAlpha = alpha end
    local cardAlpha = enabled and currentGlassAlpha or 0
    local cardColor = enabled and Color3.fromRGB(5, 5, 10) or Color3.fromRGB(12, 12, 12)
    local strokeAlpha = enabled and 0.40 or 0
    local btnAlpha = enabled and math.clamp(currentGlassAlpha, 0.4, 0.85) or 0
    local btnColor = enabled and Color3.fromRGB(15, 15, 22) or Color3.fromRGB(22, 22, 26)

    pcall(function()
        if MAINUIframe then
            MAINUIframe.BackgroundTransparency = enabled and 1 or 0
        end
    end)

    pcall(function()
        local sb = SidebarFrame or (MAINUIframe and MAINUIframe:FindFirstChild("SidebarFrame"))
        if sb then
            sb.BackgroundColor3 = enabled and Color3.fromRGB(5, 5, 10) or Color3.fromRGB(14, 14, 18)
            sb.BackgroundTransparency = enabled and currentGlassAlpha or 0
            local st = sb:FindFirstChildOfClass("UIStroke")
            if st then
                st.Transparency = enabled and 0.35 or 0
            end
        end
    end)

    pcall(function()
        local fs = MAINUIframe and MAINUIframe:FindFirstChild("FakeScrollBar")
        if fs then
            fs.BackgroundTransparency = enabled and 0.8 or 0
        end
    end)

    pcall(function()
        local ts = PagesFolder and PagesFolder:FindFirstChild("Home_Page") and PagesFolder.Home_Page:FindFirstChild("TopSwitcher")
        if ts then
            ts.BackgroundTransparency = enabled and currentGlassAlpha or 0
            ts.BackgroundColor3 = enabled and Color3.fromRGB(5, 5, 10) or Color3.fromRGB(18, 18, 24)
        end
    end)

    pcall(function()
        local sc = PagesFolder and PagesFolder:FindFirstChild("Home_Page") and PagesFolder.Home_Page:FindFirstChild("DashboardView") and PagesFolder.Home_Page.DashboardView:FindFirstChild("StatsCard")
        if sc then
            sc.BackgroundTransparency = enabled and currentGlassAlpha or 0
            sc.BackgroundColor3 = enabled and Color3.fromRGB(5, 5, 10) or Color3.fromRGB(14, 14, 18)
            local st = sc:FindFirstChildOfClass("UIStroke")
            if st then st.Transparency = enabled and 0.40 or 0 end
        end
    end)

    pcall(function()
        if NavButtons then
            for _, b in pairs(NavButtons) do
                if b and b.Parent then
                    b.BackgroundTransparency = enabled and currentGlassAlpha or 0
                end
            end
        end
    end)

    for _, card in ipairs(AllCardFrames) do
        if card and card.Parent then
            pcall(function()
                card.BackgroundColor3 = cardColor
                card.BackgroundTransparency = cardAlpha
                local st = card:FindFirstChildOfClass("UIStroke")
                if st then
                    st.Transparency = strokeAlpha
                end
            end)
        end
    end

    for _, btn in ipairs(AllUIButtons) do
        if btn and btn.Parent then
            pcall(function()
                btn.BackgroundColor3 = btnColor
                btn.BackgroundTransparency = btnAlpha
            end)
        end
    end

    pcall(function()
        if getgenv().SacredUIWallpaper then
            if enabled then
                if getgenv().SacredUIWallpaper.Image == "" or getgenv().SacredUIWallpaper.Image == nil then
                    getgenv().SacredUIWallpaper.Image = "rbxassetid://132404081379154"
                end
                getgenv().SacredUIWallpaper.ImageTransparency = 0
                getgenv().SacredUIWallpaper.Visible = true
            else
                getgenv().SacredUIWallpaper.ImageTransparency = 1 - (currentWallpaperOpacity or 0.85)
            end
        end
    end)

    if btnToggleTransparent then
        btnToggleTransparent.Text = enabled and "Transparent UI: ON" or "Transparent UI: OFF"
        btnToggleTransparent.TextColor3 = enabled and Color3.fromRGB(100, 255, 150) or Color3.fromRGB(230, 230, 240)
    end
end
