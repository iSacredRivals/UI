                            local dist = math.floor((myPos - hrp.Position).Magnitude)
                            local hpPct = math.floor((hum.Health / math.max(hum.MaxHealth, 1)) * 100)

                            if data.style == "General" then
                                local bM = type(pData.bounty) == "number" and math.floor(pData.bounty / 1000000) or 0
                                local isPvpDisabled = (p:GetAttribute("PvpDisabled") == true)
                                local warnTag = (type(pData.bounty) == "number" and pData.bounty > 10000000) and "[!] " or ""

                                local parts = {}
                                parts[#parts+1] = warnTag .. "[" .. pData.team .. "] <font color=\"rgb(255,255,0)\">" .. (p.DisplayName or p.Name) .. "</font> [Lv." .. tostring(pData.level) .. "]\n"
                                if isPvpDisabled then
                                    parts[#parts+1] = "<font color=\"rgb(0,255,0)\">[SAFE] PvP Disabled </font>| Bounty: " .. tostring(bM) .. "M\n"
                                else
                                    parts[#parts+1] = "[PVP] PVP Enabled | Bounty: " .. tostring(bM) .. "M\n"
                                end
                                parts[#parts+1] = "Fruit: " .. tostring(pData.fruit) .. "\n"
                                parts[#parts+1] = tostring(dist) .. "m | HP " .. tostring(hpPct) .. "%"

                                data.lbl.TextColor3 = col
                                data.lbl.Text = table.concat(parts)
                            else
                                data.lbl.TextColor3 = col
                                data.lbl.Text = string.format("%s [%dm]\nHP: %d/%d (%d%%)",
                                    p.DisplayName or p.Name, dist,
                                    math.floor(hum.Health), math.floor(hum.MaxHealth), hpPct
                                )
                            end

                            if data.hl then
                                data.hl.Enabled = (dist <= 150)
                            end
                        end

                        if data.hl then
                            data.hl.FillColor = col
                            data.hl.OutlineColor = col
                        end
                    else
                        cleanPlayerBespokeESP(p)
                    end
                else
                    cleanPlayerBespokeESP(p)
                end
            end)
        end

        -- 2. MATCHA ESP (LARGE SKELETON + 2D & 3D SQUARE BOX)
        if FeatureStates["EspMatcha"] and cam then
            for p, data in pairs(matchaESPStore) do
                pcall(function()
                    if p.Parent and data.char and data.char.Parent and data.hum and data.hum.Parent and data.hum.Health > 0 then
                        local char = data.char
                        local hum = data.hum

                        if data.square then
                            drawBox(data.square, char, cam, MATCHA_COLOR)
                        end

                        if data.lines and #data.lines > 0 then
                            local lines = data.lines
                            local head = char:FindFirstChild("Head")
                            if head then
                                local isR15 = (hum.RigType == Enum.HumanoidRigType.R15)
                                if isR15 then
                                    local uTorso = char:FindFirstChild("UpperTorso")
                                    local lTorso = char:FindFirstChild("LowerTorso")
                                    local lArm = char:FindFirstChild("LeftUpperArm")
                                    local lElbow = char:FindFirstChild("LeftLowerArm")
                                    local lHand = char:FindFirstChild("LeftHand")
                                    local rArm = char:FindFirstChild("RightUpperArm")
                                    local rElbow = char:FindFirstChild("RightLowerArm")
                                    local rHand = char:FindFirstChild("RightHand")
                                    local lLeg = char:FindFirstChild("LeftUpperLeg")
                                    local lKnee = char:FindFirstChild("LeftLowerLeg")
                                    local lFoot = char:FindFirstChild("LeftFoot")
                                    local rLeg = char:FindFirstChild("RightUpperLeg")
                                    local rKnee = char:FindFirstChild("RightLowerLeg")
                                    local rFoot = char:FindFirstChild("RightFoot")

                                    drawBone(lines[1], head, uTorso, cam, MATCHA_COLOR)
                                    drawBone(lines[2], uTorso, lTorso, cam, MATCHA_COLOR)
                                    drawBone(lines[3], uTorso, lArm, cam, MATCHA_COLOR)
                                    drawBone(lines[4], lArm, lElbow, cam, MATCHA_COLOR)
                                    drawBone(lines[5], lElbow, lHand, cam, MATCHA_COLOR)
                                    drawBone(lines[6], uTorso, rArm, cam, MATCHA_COLOR)
                                    drawBone(lines[7], rArm, rElbow, cam, MATCHA_COLOR)
                                    drawBone(lines[8], rElbow, rHand, cam, MATCHA_COLOR)
                                    drawBone(lines[9], lTorso, lLeg, cam, MATCHA_COLOR)
                                    drawBone(lines[10], lLeg, lKnee, cam, MATCHA_COLOR)
                                    drawBone(lines[11], lKnee, lFoot, cam, MATCHA_COLOR)
                                    drawBone(lines[12], lTorso, rLeg, cam, MATCHA_COLOR)
                                    drawBone(lines[13], rLeg, rKnee, cam, MATCHA_COLOR)
                                    drawBone(lines[14], rKnee, rFoot, cam, MATCHA_COLOR)
                                else
