local function createCycleButton(parent, prefixEN, prefixES, choices, defaultIdx, size, pos, onChange)
    local currentIdx = defaultIdx or 1
    local btn = Instance.new("TextButton")
    btn.Size = size
    btn.Position = pos
    btn.BackgroundColor3 = Color3.fromRGB(22, 22, 26)
    btn.Font = Enum.Font.GothamBold
    local pre = (CurrentLang == "EN") and prefixEN or prefixES
    btn.Text = string.format("  %s: %s", pre, tostring(choices[currentIdx]))
    btn.TextSize = 13
    btn.TextColor3 = Color3.fromRGB(225, 225, 225)
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.AutoButtonColor = true
    btn.Parent = parent
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

    table.insert(TranslatableUI, {
        btn = btn,
        prefixEN = prefixEN,
        prefixES = prefixES,
        getChoice = function() return tostring(choices[currentIdx]) end,
        isCycle = true
    })
    table.insert(AllUIButtons, btn)
    if isSacredTransparentActive then
        btn.BackgroundColor3 = Color3.fromRGB(15, 15, 22)
        btn.BackgroundTransparency = currentGlassAlpha
    end

    btn.MouseButton1Click:Connect(function()
        currentIdx = (currentIdx % #choices) + 1
        local choice = choices[currentIdx]
        local p = (CurrentLang == "EN") and prefixEN or prefixES
        btn.Text = string.format("  %s: %s", p, tostring(choice))
        if onChange then onChange(choice, currentIdx) end
    end)
    return btn
end

applyLanguage = function(lang)
    CurrentLang = (lang == "ES") and "ES" or "EN"
    _G.Darling_CurrentLang = CurrentLang
    for _, item in ipairs(TranslatableUI) do
        pcall(function()
            if item.isHeader and item.label then
                item.label.Text = (CurrentLang == "EN") and item.en or item.es
            elseif item.isToggle and item.btn then
                item.btn.Text = "  " .. ((CurrentLang == "EN") and item.rawEN or item.rawES)
                if item.toggleName and ToggleButtons[item.toggleName] then
                    ToggleButtons[item.toggleName].text = (CurrentLang == "EN") and item.rawEN or item.rawES
                end
            elseif item.isCycle and item.btn then
                local p = (CurrentLang == "EN") and item.prefixEN or item.prefixES
                local choice = item.getChoice and item.getChoice() or ""
                item.btn.Text = string.format("  %s: %s", p, choice)
            elseif item.label then
                item.label.Text = (CurrentLang == "EN") and item.en or item.es
            elseif item.btn then
                item.btn.Text = (CurrentLang == "EN") and item.en or item.es
            end
        end)
    end
    if btnDash then
        btnDash.Text = (CurrentLang == "ES") and "Panel" or "Dashboard"
    end
    if btnCustoms then
        btnCustoms.Text = (CurrentLang == "ES") and "Personalizar" or "UI Customs"
    end
    if btnConfigs then
        btnConfigs.Text = (CurrentLang == "ES") and "Ajustes" or "Configs"
    end
    if btnTogglePicture then
        btnTogglePicture.Text = isPictureVisible and ((CurrentLang == "ES") and "Imagen: ON" or "Picture: ON") or ((CurrentLang == "ES") and "Imagen: OFF" or "Picture: OFF")
    end
    if btnToggleTransparent then
        btnToggleTransparent.Text = isSacredTransparentActive and ((CurrentLang == "ES") and "Transparente: ON" or "Transparent UI: ON") or ((CurrentLang == "ES") and "Transparente: OFF" or "Transparent UI: OFF")
    end
    if autoBountyMainBtn then
        local abActive = (getgenv().DarlingAutoBountyEnabled == true) or (FeatureStates["AutoBounty"] == true)
        autoBountyMainBtn.Text = abActive and ((CurrentLang == "ES") and "Detener Auto Bounty [BETA]" or "Stop Auto Bounty [BETA]") or ((CurrentLang == "ES") and "Activar Auto Bounty [BETA]" or "Activate Auto Bounty [BETA]")
    end
    if fruitVBtn then
        local ftActive = (getgenv().FruitTransform == true) or (FeatureStates["FruitTransform"] == true)
        fruitVBtn.Text = ftActive and ((CurrentLang == "ES") and "Fruit V (Transformación): ON" or "Fruit V (Transform): ON") or ((CurrentLang == "ES") and "Fruit V (Transformación): OFF" or "Fruit V (Transform): OFF")
    end
    notifyToggle((CurrentLang == "ES") and "Idioma cambiado a Español" or "Language changed to English", true)
end
