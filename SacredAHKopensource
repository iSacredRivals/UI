    local function applySkillsLayoutPreset(presetName)
        local pGui = LocalPlayer:FindFirstChild("PlayerGui")
        local main = pGui and pGui:FindFirstChild("Main")
        local skills = main and main:FindFirstChild("Skills")
        if not skills then
            notifyToggle("Skills frame not found in PlayerGui", false)
            return
        end

        local skillNames = { "Z", "X", "C", "V", "F" }
        for idx, key in ipairs(skillNames) do
            local sBtn = skills:FindFirstChild(key) or skills:FindFirstChild("Skill_" .. key)
            if sBtn then
                if presetName == "Horizontal" then
                    sBtn.Position = UDim2.new(0, (idx - 1) * 65, 0, 0)
                elseif presetName == "Vertical" then
                    sBtn.Position = UDim2.new(0, 0, 0, (idx - 1) * 65)
                elseif presetName == "Grid" then
