    local function isFruitObject(obj)
        if not obj or not obj.Parent then return false end
        local name = string.lower(obj.Name)
        if name:find("fruit") or name:find("fruta") then return true end
        if obj:FindFirstChild("Fruit") or obj:FindFirstChild("FruitName") or obj:FindFirstChild("EatRemote") or obj:GetAttribute("Fruit") then return true end
        if (obj:IsA("Tool") or obj:IsA("Model")) and name:find("-") then
            if obj:FindFirstChild("Handle") or obj:FindFirstChildOfClass("MeshPart") or obj:FindFirstChildOfClass("SpecialMesh", true) then
                return true
            end
        end
        return false
    end

    local function applyScaleToFruit(fruit, targetScale)
        if not fruit or not fruit.Parent then return end
        pcall(function()
            if fruit:IsA("Model") then
                if not fruit:GetAttribute("DarlingOrigScale") then
                    fruit:SetAttribute("DarlingOrigScale", fruit:GetScale() or 1)
                end
                local orig = fruit:GetAttribute("DarlingOrigScale") or 1
                fruit:ScaleTo(orig * targetScale)
            end
            for _, part in ipairs(fruit:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                    part.Massless = true
                    if not fruit:IsA("Model") and part.Name == "Handle" then
                        if not part:GetAttribute("OrigPartSize") then
                            part:SetAttribute("OrigPartSize", part.Size)
                        end
                        part.Size = (part:GetAttribute("OrigPartSize") or Vector3.new(1,1,1)) * targetScale
                    end
                elseif part:IsA("SpecialMesh") and not fruit:IsA("Model") then
                    if not part:GetAttribute("OrigMeshScale") then
                        part:SetAttribute("OrigMeshScale", part.Scale)
                    end
                    part.Scale = (part:GetAttribute("OrigMeshScale") or Vector3.new(1,1,1)) * targetScale
                end
            end
        end)
    end

    local function restoreAllFruitScales()
        pcall(function()
            for _, item in ipairs(workspace:GetChildren()) do
                if isFruitObject(item) and item:IsA("Model") and item:GetAttribute("DarlingOrigScale") then
                    pcall(function() item:ScaleTo(item:GetAttribute("DarlingOrigScale")) end)
                end
            end
            local fruitFolder = workspace:FindFirstChild("Fruit") or workspace:FindFirstChild("Fruits") or workspace:FindFirstChild("Items")
            if fruitFolder then
                for _, item in ipairs(fruitFolder:GetChildren()) do
                    if isFruitObject(item) and item:IsA("Model") and item:GetAttribute("DarlingOrigScale") then
                        pcall(function() item:ScaleTo(item:GetAttribute("DarlingOrigScale")) end)
                    end
                end
            end
            local function restoreTool(tool)
                if not tool or not isFruitObject(tool) then return end
                if tool:IsA("Model") and tool:GetAttribute("DarlingOrigScale") then
                    pcall(function() tool:ScaleTo(tool:GetAttribute("DarlingOrigScale")) end)
                else
                    for _, part in ipairs(tool:GetDescendants()) do
                        if part:IsA("BasePart") and part:GetAttribute("OrigPartSize") then
                            part.Size = part:GetAttribute("OrigPartSize")
                        elseif part:IsA("SpecialMesh") and part:GetAttribute("OrigMeshScale") then
                            part.Scale = part:GetAttribute("OrigMeshScale")
                        end
                    end
                end
            end
            local char = LocalPlayer.Character
            if char then
                for _, tool in ipairs(char:GetChildren()) do
                    if tool:IsA("Tool") then restoreTool(tool) end
                end
            end
            local bp = LocalPlayer:FindFirstChild("Backpack")
            if bp then
                for _, tool in ipairs(bp:GetChildren()) do
                    if tool:IsA("Tool") then restoreTool(tool) end
                end
            end
        end)
