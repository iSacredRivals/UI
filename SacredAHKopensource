    local function renderTracer(lineObj, adornObj, guiLineObj, fromPos, toPos)
        if not fromPos or not toPos then
            if lineObj then lineObj.Visible = false end
            if adornObj then adornObj.Visible = false end
            if guiLineObj then guiLineObj.Visible = false end
            return
        end

        local cam = workspace.CurrentCamera
        if cam then
            local vp = cam.ViewportSize
            local p0 = cam:WorldToViewportPoint(fromPos)
            local p1 = cam:WorldToViewportPoint(toPos)

            local screenOrigin = Vector2.new(vp.X / 2, vp.Y - 18)
            if p0.Z > 0 and (p0.X >= 0 and p0.X <= vp.X and p0.Y >= 0 and p0.Y <= vp.Y) then
                screenOrigin = Vector2.new(p0.X, p0.Y)
            end

            local screenTarget
            if p1.Z > 0 then
                screenTarget = Vector2.new(p1.X, p1.Y)
            else
                local center = Vector2.new(vp.X / 2, vp.Y / 2)
                local dir = Vector2.new(-p1.X + center.X, -p1.Y + center.Y)
                if dir.Magnitude == 0 then dir = Vector2.new(0, 1) end
                local dUnit = dir.Unit
                local scaleX = (vp.X / 2 - 25) / math.max(math.abs(dUnit.X), 0.001)
                local scaleY = (vp.Y / 2 - 25) / math.max(math.abs(dUnit.Y), 0.001)
                local scale = math.min(scaleX, scaleY)
                screenTarget = center + dUnit * scale
            end

            if guiLineObj then
                local delta = screenTarget - screenOrigin
                local dist = delta.Magnitude
                local angle = math.deg(math.atan2(delta.Y, delta.X))
                guiLineObj.Size = UDim2.new(0, dist, 0, 2.5)
                guiLineObj.Position = UDim2.new(0, (screenOrigin.X + screenTarget.X) / 2, 0, (screenOrigin.Y + screenTarget.Y) / 2)
                guiLineObj.Rotation = angle
                guiLineObj.Visible = true
            end

            if lineObj then
                lineObj.From = screenOrigin
                lineObj.To = screenTarget
                lineObj.Visible = true
            end
        end

        if adornObj then
            local dist = (toPos - fromPos).Magnitude
            if dist > 0.5 then
                adornObj.CFrame = CFrame.lookAt(fromPos, toPos)
                adornObj.Length = dist
                adornObj.Visible = true
            else
                adornObj.Visible = false
            end
        end
    end

