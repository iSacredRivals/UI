local function enableAntiTeleportFail()
    pcall(function()
        local CoreGui = game:GetService("CoreGui")
        local promptOverlay = CoreGui:FindFirstChild("RobloxPromptGui")
            and CoreGui.RobloxPromptGui:FindFirstChild("promptOverlay")
