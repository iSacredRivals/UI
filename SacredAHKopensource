    local function getFullConfigSnapshot()
        local snapshot = {
            FeatureStates = {},
            Settings = {},
            PCKeybinds = {},
            MacroSteps = {},
            UICustom = {},
            CurrentLang = CurrentLang,
            Version = "DARLING_CONFIG"
        }
        for k, v in pairs(FeatureStates) do
            snapshot.FeatureStates[k] = v
        end
        snapshot.FeatureStates["AutoBounty"] = (getgenv().DarlingAutoBountyEnabled == true) or (FeatureStates["AutoBounty"] == true)
        snapshot.FeatureStates["FruitTransform"] = (getgenv().FruitTransform == true) or (FeatureStates["FruitTransform"] == true)
        snapshot.ControlsLayout = _G.DarlingAHK_ControlsLayout or {}
        for k, v in pairs(Settings) do
            if type(v) ~= "function" and type(v) ~= "userdata" and type(v) ~= "table" then
                snapshot.Settings[k] = v
            end
        end
        snapshot.Settings.DarlingHuntTweenSpeed = getgenv().DarlingHuntTweenSpeed or 350
        for k, v in pairs(Settings) do
            if type(v) ~= "function" and type(v) ~= "userdata" and type(v) ~= "table" then
                snapshot.Settings[k] = v
            end
        end
        if Settings.macroSteps then
            for i, st in ipairs(Settings.macroSteps) do
                snapshot.MacroSteps[i] = {
                    slot = i,
                    enabled = (st.enabled ~= false),
                    tool = st.tool or "Melee",
                    key = st.key or "Z",
                    delay = st.delay or 0.30,
                    hold = st.hold or 0.10
                }
            end
        end
        if PCKeybinds and type(PCKeybinds) == "table" then
            for i, kb in ipairs(PCKeybinds) do
                snapshot.PCKeybinds[i] = {
                    id = kb.id,
                    name = kb.name,
                    keyName = kb.key and kb.key.Name or nil,
                    mode = kb.mode or "Toggle"
                }
            end
        end
        snapshot.UICustom = {
            wallpaper = getgenv().SacredUIWallpaper and getgenv().SacredUIWallpaper.Image or "",
            isTransparent = isSacredTransparentActive,
            isPictureVisible = isPictureVisible,
            theme = CurrentTheme or "Dark Noir (Default)",
            opacity = currentWallpaperOpacity or 0.85
        }
        return snapshot
    end

    local function applyFullConfigSnapshot(snapshot)
        if not snapshot or type(snapshot) ~= "table" then return false end
        if snapshot.FeatureStates then
            for name, state in pairs(snapshot.FeatureStates) do
                setFeatureState(name, state)
            end
            if snapshot.FeatureStates["AutoBounty"] ~= nil then
                FeatureStates["AutoBounty"] = false
            end
            if snapshot.FeatureStates["FruitTransform"] ~= nil then
                local ftActive = (snapshot.FeatureStates["FruitTransform"] == true)
                getgenv().FruitTransform = ftActive
                FeatureStates["FruitTransform"] = ftActive
                if fruitVBtn then
                    fruitVBtn.Text = ftActive and ((CurrentLang == "ES") and "Fruit V (Transformación): ON" or "Fruit V (Transform): ON") or ((CurrentLang == "ES") and "Fruit V (Transformación): OFF" or "Fruit V (Transform): OFF")
                    fruitVBtn.TextColor3 = ftActive and Color3.fromRGB(120, 255, 160) or Color3.fromRGB(230, 230, 240)
                end
            end
        end
        if snapshot.Settings then
            for k, v in pairs(snapshot.Settings) do
                Settings[k] = v
            end
            if snapshot.Settings.DarlingHuntTweenSpeed then
                getgenv().DarlingHuntTweenSpeed = snapshot.Settings.DarlingHuntTweenSpeed
            end
        end
        if snapshot.MacroSteps and Settings.macroSteps then
            for i, st in ipairs(snapshot.MacroSteps) do
                if Settings.macroSteps[i] then
                    Settings.macroSteps[i].enabled = (st.enabled ~= false)
                    Settings.macroSteps[i].tool = st.tool or "Melee"
                    Settings.macroSteps[i].key = st.key or "Z"
                    Settings.macroSteps[i].delay = tonumber(st.delay) or 0.30
                    Settings.macroSteps[i].hold = tonumber(st.hold) or 0.10
                end
            end
            if refreshMacroStepsUI then pcall(refreshMacroStepsUI) end
            if _G.refreshMacroStepsUI then pcall(_G.refreshMacroStepsUI) end
        end
        if snapshot.PCKeybinds and PCKeybinds and type(PCKeybinds) == "table" then
            table.clear(PCKeybinds)
            for i, kb in ipairs(snapshot.PCKeybinds) do
                local kCode = kb.keyName and Enum.KeyCode[kb.keyName] or nil
                table.insert(PCKeybinds, {
                    id = kb.id,
                    name = kb.name,
                    key = kCode,
                    mode = kb.mode or "Toggle"
                })
            end
            if refreshKeybindsList then pcall(refreshKeybindsList) end
            if _G.RefreshKeybindsList then pcall(_G.RefreshKeybindsList) end
        end
        if snapshot.UICustom then
            local u = snapshot.UICustom
            if u.wallpaper and getgenv().SacredUIWallpaper then
                getgenv().SacredUIWallpaper.Image = u.wallpaper
                getgenv().SacredUIWallpaper.Visible = (u.wallpaper ~= "")
            end
            if u.isTransparent ~= nil then
                setSacredTransparentMode(u.isTransparent)
            end
            if u.isPictureVisible ~= nil and setPictureVisible then
                setPictureVisible(u.isPictureVisible)
            end
            if u.theme and applyTheme then
                applyTheme(u.theme)
            end
        end
        if snapshot.ControlsLayout and type(snapshot.ControlsLayout) == "table" then
            _G.DarlingAHK_ControlsLayout = snapshot.ControlsLayout
            pcall(function()
                if writefile then
                    writefile("DarlingAHK_ControlsLayout.json", HttpService:JSONEncode(snapshot.ControlsLayout))
                end
            end)
        end
        if snapshot.CurrentLang and applyLanguage then
            applyLanguage(snapshot.CurrentLang)
        end
        return true
    end

    local function applyMacroStepsData(data)
        if not data or not Settings.macroSteps then return false end
        local rawSteps = data.steps or data.MacroSteps or (data[1] and data)
        if not rawSteps or type(rawSteps) ~= "table" then return false end

        for i = 1, 14 do
            local s = rawSteps[i]
            if s then
                Settings.macroSteps[i].enabled = (s.enabled ~= false)
                Settings.macroSteps[i].tool = s.weapon or s.tool or "Melee"
                Settings.macroSteps[i].key = s.skill or s.key or "Z"
                Settings.macroSteps[i].delay = tonumber(s.delay) or 0.30
                Settings.macroSteps[i].hold = tonumber(s.hold) or 0.10
            else
                Settings.macroSteps[i].enabled = false
            end
