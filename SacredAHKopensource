    local function applyGiantSkinAndBody(targetScale)
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not char or not hum then return end

        pcall(function()
            hum:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
            hum.Sit = false

            for _, n in ipairs({"BodyWidthScale", "BodyHeightScale", "BodyDepthScale", "HeadScale"}) do
                local val = hum:FindFirstChild(n)
                if not val then
                    val = Instance.new("NumberValue")
                    val.Name = n
                    val.Parent = hum
                end
                val.Value = targetScale
            end
            hum.HipHeight = 2 * targetScale

            if char:IsA("Model") then
                if not char:GetAttribute("OrigCharScale") then
                    char:SetAttribute("OrigCharScale", char:GetScale() or 1)
                end
                char:ScaleTo((char:GetAttribute("OrigCharScale") or 1) * targetScale)
            end

            for _, part in ipairs(char:GetChildren()) do
                if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                    if not origPartSizes[part] then
                        origPartSizes[part] = part.Size
                    end
                    part.Size = origPartSizes[part] * targetScale
                    local mesh = part:FindFirstChildOfClass("SpecialMesh")
                    if mesh then
                        if not mesh:GetAttribute("OrigMeshScale") then
                            mesh:SetAttribute("OrigMeshScale", mesh.Scale)
                        end
                        mesh.Scale = (mesh:GetAttribute("OrigMeshScale") or Vector3.new(1,1,1)) * targetScale
                    end
                end
            end
        end)

        if not giantNoclipConn then
            giantNoclipConn = RunService.Stepped:Connect(function()
                local c = LocalPlayer.Character
                if c and FeatureStates["GiantMode"] then
                    local h = c:FindFirstChildOfClass("Humanoid")
                    if h then
                        h:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
                        if h.Sit then h.Sit = false end
                    end
                    for _, p in ipairs(c:GetDescendants()) do
                        if p:IsA("BasePart") then
                            p.CanCollide = false
                        end
                    end
                end
            end)
        end
    end

    local function restoreGiantSkinAndBody()
        if giantNoclipConn then
            giantNoclipConn:Disconnect()
            giantNoclipConn = nil
        end

        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not char or not hum then return end
        pcall(function()
            hum:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
            hum.Sit = false

            for _, n in ipairs({"BodyWidthScale", "BodyHeightScale", "BodyDepthScale", "HeadScale"}) do
                local val = hum:FindFirstChild(n)
                if val and val:IsA("NumberValue") then val.Value = 1 end
            end
            hum.HipHeight = 2
            if char:IsA("Model") and char:GetAttribute("OrigCharScale") then
                char:ScaleTo(char:GetAttribute("OrigCharScale") or 1)
            end
            for part, origSize in pairs(origPartSizes) do
                if part and part.Parent then
                    part.Size = origSize
                    local mesh = part:FindFirstChildOfClass("SpecialMesh")
                    if mesh and mesh:GetAttribute("OrigMeshScale") then
                        mesh.Scale = mesh:GetAttribute("OrigMeshScale")
                    end
                    part.CanCollide = true
                end
            end
            origPartSizes = {}
        end)
    end

