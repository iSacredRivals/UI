    local function faceMacroTarget()
        pcall(function()
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end

            local targetHrp = nil
            if CurrentCamLockTarget and CurrentCamLockTarget.Parent and CurrentCamLockTarget:FindFirstChild("HumanoidRootPart") then
                targetHrp = CurrentCamLockTarget:FindFirstChild("HumanoidRootPart")
            else
                local myPos = hrp.Position
                local bestDist = 250
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                        local dist = (p.Character.HumanoidRootPart.Position - myPos).Magnitude
                        if dist < bestDist then
                            bestDist = dist
                            targetHrp = p.Character.HumanoidRootPart
                        end
                    end
                end
            end

            if targetHrp then
                local pingSec = getClientPing() / 1000
                local vel = targetHrp.AssemblyLinearVelocity or Vector3.zero
                local predictedPos = targetHrp.Position + (vel * math.clamp(pingSec, 0.02, 0.25))
                local lookVec = predictedPos - hrp.Position
                if lookVec.Magnitude > 0.5 then
                    hrp.CFrame = CFrame.lookAt(hrp.Position, Vector3.new(predictedPos.X, hrp.Position.Y, predictedPos.Z))
                end
            end
        end)
    end

