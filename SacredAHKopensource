    local COLOR_FILTERS = {
        { sat = 0, con = 0, bright = 0, tint = Color3.fromRGB(255, 255, 255) },
        { sat = 0.2, con = 0.15, bright = 0.02, tint = Color3.fromRGB(255, 225, 200) },
        { sat = -0.1, con = 0.2, bright = 0.05, tint = Color3.fromRGB(180, 215, 255) },
        { sat = -0.8, con = 0.4, bright = 0.2, tint = Color3.fromRGB(80, 255, 120) },
        { sat = -1.0, con = 0.3, bright = 0, tint = Color3.fromRGB(255, 255, 255) },
    }

    FeatureCallbacks["ColorFilter"] = function(v)
        ensureShaders()
        local cf = COLOR_FILTERS[Settings.filterIdx] or COLOR_FILTERS[1]
        if v then
            fxCC.Saturation = cf.sat
            fxCC.Contrast = cf.con
            fxCC.Brightness = cf.bright
