local function loadKeybindsFromFile()
    pcall(function()
        local raw = nil
        if isfile and isfile("DarlingAHK_Keybinds.json") and readfile then
            raw = readfile("DarlingAHK_Keybinds.json")
        elseif isfile and isfile("SacredAHK_Keybinds.json") and readfile then
            raw = readfile("SacredAHK_Keybinds.json")
        end
        if raw and raw ~= "" then
            local data = HttpService:JSONDecode(raw)
            if type(data) == "table" and #data > 0 then
                table.clear(PCKeybinds)
                for _, item in ipairs(data) do
                    local kn = item.keyName or item.key
                    local kc = (kn and kn ~= "None") and Enum.KeyCode[kn] or nil
                    table.insert(PCKeybinds, {
                        id = item.id,
                        name = item.name,
                        key = kc,
                        mode = item.mode or "Toggle"
                    })
                end
            end
        end
    end)
end
