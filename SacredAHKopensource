    local function tweenToTarget(targetHRP, hoverOffset)
        local lp = LocalPlayer
        if not lp.Character then return false end
        local hrp = lp.Character:FindFirstChild("HumanoidRootPart")
        local hum = lp.Character:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum or hum.Health <= 0 then return false end

        if hum.Sit then
            hum.Sit = false
            for _, w in ipairs(hrp:GetChildren()) do
                if w:IsA("Weld") or w:IsA("SeatWeld") or w.Name == "SeatWeld" then
                    pcall(function() w:Destroy() end)
                end
            end
        end

        ensureHold(hrp)

        while _G.AutoFarmOvercharged and isCurrentSession() do
            if not targetHRP or not targetHRP.Parent then
                stopFlight()
                return false
            end

            local targetCFrame = targetHRP.CFrame * CFrame.new(0, hoverOffset, 0)
            local targetPos = targetCFrame.Position
            local distance = (targetPos - hrp.Position).Magnitude

            if distance <= 8 then
                if hunterActiveTween then
                    pcall(function() hunterActiveTween:Cancel() end)
                    hunterActiveTween = nil
                end
                return true
            end

            local speed = _G.FlySpeed or 320
            local duration = math.clamp(distance / speed, 0.1, 9999)

            if hunterActiveTween then
                pcall(function() hunterActiveTween:Cancel() end)
                hunterActiveTween = nil
            end

            hunterActiveTween = TweenService:Create(
                hrp,
                TweenInfo.new(duration, Enum.EasingStyle.Linear),
                { CFrame = targetCFrame }
            )
            hunterActiveTween:Play()

            local stepStart = os.clock()
            while hunterActiveTween and _G.AutoFarmOvercharged and isCurrentSession() do
                task.wait(0.08)

                if not hrp or not hrp.Parent or not hum or hum.Health <= 0 then
                    stopFlight()
                    return false
                end
                if not targetHRP or not targetHRP.Parent then
                    stopFlight()
                    return false
                end

                local curDist = (targetHRP.Position + Vector3.new(0, hoverOffset, 0) - hrp.Position).Magnitude
                if curDist <= 8 then
                    if hunterActiveTween then
                        pcall(function() hunterActiveTween:Cancel() end)
                        hunterActiveTween = nil
                    end
                    return true
                end

                local currentGoal = (targetHRP.CFrame * CFrame.new(0, hoverOffset, 0)).Position
                if (currentGoal - targetPos).Magnitude > 20 then
                    break
                end

                if (os.clock() - stepStart) >= duration then
                    break
                end
            end
        end

        return false
    end

    local function IsOverchargedMob(v)
        if not (v and v:IsA("Model")) then return false end
        if hunterDeadMobs[v] and os.clock() < hunterDeadMobs[v] then return false end

        local hum = v:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then return false end
        pcall(function()
            if hum:GetState() == Enum.HumanoidStateType.Dead then hum = nil end
        end)
        if not hum then return false end

        local hrp = v:FindFirstChild("HumanoidRootPart")
        if not hrp then return false end

        local nameLower = string.lower(v.Name)
        if string.find(nameLower, "overcharged", 1, true) or string.find(nameLower, "magnetized", 1, true) then
            return true
        end

        local disp = hum.DisplayName
        if disp and disp ~= "" then
            local dispLower = string.lower(disp)
            if string.find(dispLower, "overcharged", 1, true) or string.find(dispLower, "magnetized", 1, true) then
                return true
            end
        end

        local head = v:FindFirstChild("Head")
        if head then
            for _, c in ipairs(head:GetChildren()) do
                if c:IsA("BillboardGui") then
                    for _, lbl in ipairs(c:GetChildren()) do
                        if lbl:IsA("TextLabel") and lbl.Text then
                            local tLower = string.lower(lbl.Text)
                            if string.find(tLower, "overcharged", 1, true) or string.find(tLower, "magnetized", 1, true) then
                                return true
                            end
                        end
                    end
                end
            end
        end

        for _, c in ipairs(v:GetChildren()) do
            if c:IsA("BillboardGui") then
                for _, lbl in ipairs(c:GetChildren()) do
                    if lbl:IsA("TextLabel") and lbl.Text then
                        local tLower = string.lower(lbl.Text)
                        if string.find(tLower, "overcharged", 1, true) or string.find(tLower, "magnetized", 1, true) then
                            return true
                        end
                    end
                end
            end
        end

        if v:FindFirstChild("Halo") or v:FindFirstChild("Magnet") or v:FindFirstChild("Overcharged") or v:FindFirstChild("Magnetized") or
           (head and (head:FindFirstChild("Halo") or head:FindFirstChild("Magnet") or head:FindFirstChild("Overcharged") or head:FindFirstChild("Magnetized"))) or
           hrp:FindFirstChild("Halo") or hrp:FindFirstChild("Magnet") or hrp:FindFirstChild("Overcharged") or hrp:FindFirstChild("Magnetized") then
            return true
        end

        return false
    end

    local function GetAllOverchargedMobs()
        local list = {}
        local seen = {}

        local function check(v)
            if not seen[v] and IsOverchargedMob(v) then
                seen[v] = true
                local hrp = v:FindFirstChild("HumanoidRootPart")
                local hum = v:FindFirstChildOfClass("Humanoid")
                if hrp and hum then
                    local disp = hum.DisplayName
                    local cleanName = (disp and (string.find(string.lower(disp), "overcharged", 1, true) or string.find(string.lower(disp), "magnetized", 1, true)) and disp) or v.Name
                    table.insert(list, {
                        Model    = v,
                        Humanoid = hum,
                        HRP      = hrp,
                        Name     = cleanName,
                        Position = hrp.Position
                    })
                end
            end
        end

        local enemies = workspace:FindFirstChild("Enemies")
        if enemies then
            for _, v in ipairs(enemies:GetChildren()) do
                if v:IsA("Model") then check(v) end
            end
        end

        local characters = workspace:FindFirstChild("Characters")
        if characters then
            for _, v in ipairs(characters:GetChildren()) do
                if v ~= LocalPlayer.Character and not Players:GetPlayerFromCharacter(v) then
                    check(v)
                end
            end
        end

        for _, v in ipairs(workspace:GetChildren()) do
            if v:IsA("Model") and v ~= LocalPlayer.Character and not Players:GetPlayerFromCharacter(v) then
                check(v)
            end
        end

        return list
    end

    local function GetClosestOverchargedMob()
        local myChar = LocalPlayer.Character
        local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if not myHRP then return nil end

        local mobs = GetAllOverchargedMobs()
        if #mobs == 0 then return nil end

        local closest = nil
        local minDist = math.huge

        for _, mob in ipairs(mobs) do
            local d = (mob.Position - myHRP.Position).Magnitude
            if d < minDist then
                minDist = d
                closest = mob
            end
        end

        return closest
    end

