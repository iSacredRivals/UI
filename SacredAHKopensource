    local lastEspTextUpdate = 0
    local rainbowHue = 0
    RunService.RenderStepped:Connect(function(dt)
        local anyActive = FeatureStates["GeneralEsp"] or FeatureStates["PlayerEsp"] or FeatureStates["NpcEsp"]
            or FeatureStates["FruitEsp"] or FeatureStates["RainbowEsp"] or FeatureStates["EspMatcha"]
            or FeatureStates["TracersAll"]
        if not anyActive then
            if #allTracersLines > 0 then
                for _, l in ipairs(allTracersLines) do
                    if l then pcall(function() l.Visible = false end) end
                end
            end
            return
        end

        local cam = workspace.CurrentCamera
        if FeatureStates["TracersAll"] and cam then
            local origin = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y)
            local lineIdx = 0
            local lookVec = cam.CFrame.LookVector
            local camPos = cam.CFrame.Position

            local function drawTracersAllTarget(entPos, col)
                local toEnt = entPos - camPos
                if lookVec:Dot(toEnt.Unit) > 0.05 then
                    local sp, onScreen = cam:WorldToViewportPoint(entPos)
                    if onScreen and sp.Z > 0 then
                        lineIdx = lineIdx + 1
                        local p1 = Vector2.new(sp.X, sp.Y)
                        local dLine = allTracersLines[lineIdx]
                        if not dLine and Drawing and Drawing.new then
                            dLine = createDrawingLine()
                            allTracersLines[lineIdx] = dLine
                        end
                        if dLine then
                            dLine.Visible = true
                            dLine.From = origin
                            dLine.To = p1
                            dLine.Color = col or Color3.fromRGB(0, 255, 200)
                            dLine.Thickness = 1.5
                            dLine.Transparency = 1
                        else
                            local gLine = getTracersAllGuiLine(lineIdx)
                            if gLine then
                                local mid = (origin + p1) / 2
                                local diff = p1 - origin
                                local dist = diff.Magnitude
                                local angle = math.atan2(diff.Y, diff.X)
                                gLine.Size = UDim2.new(0, dist, 0, 1.5)
                                gLine.Position = UDim2.new(0, mid.X, 0, mid.Y)
                                gLine.Rotation = math.deg(angle)
                                gLine.BackgroundColor3 = col or Color3.fromRGB(0, 255, 200)
                                gLine.Visible = true
                            end
                        end
                    end
                end
            end

            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character then
                    local r = p.Character:FindFirstChild("HumanoidRootPart") or p.Character:FindFirstChild("Head")
